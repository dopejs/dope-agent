[Unit]
# Kura systemd service template.
# Tokens (@NAME@) are substituted by deploy/install.sh.
# Works both as a user service (systemctl --user) and a system service
# (/etc/systemd/system). For a system service the installer also writes
# User=/Group= lines after @SYSTEM_USER_BLOCK@.
Description=Kura daemon (personal agent OS control plane)
Documentation=https://github.com/dopejs/kura
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@KURA_BIN@
Environment=KURA_ENV=@KURA_ENV@
Environment=KURA_DATA_DIR=@KURA_DATA_DIR@
Environment=KURA_BIND_ADDR=@KURA_BIND_ADDR@
Environment=KURA_VERSION=@KURA_VERSION@
Environment=KURA_LOG_LEVEL=@KURA_LOG_LEVEL@
# Live connectors default off so the daemon boots without external
# credentials; opt in at install time (see install.sh).
Environment=KURA_CONNECTORS_DISCORD_ENABLED=@KURA_DISCORD_ENABLED@
WorkingDirectory=@KURA_DATA_DIR@
@SYSTEM_USER_BLOCK@
# Restart on failure, but back off so a broken config does not hot-loop.
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

# Hardening (safe for a single-node self-host; relax if it blocks a feature).
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=@SYSTEMD_WANTED_BY@
