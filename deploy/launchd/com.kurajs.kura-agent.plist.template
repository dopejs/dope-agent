<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Kura launchd user agent template.
  Tokens (@NAME@) are substituted by deploy/install.sh; do not edit the installed
  copy by hand unless you know what you are doing — re-run the installer instead.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kurajs.kura-agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>@KURA_BIN@</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>KURA_ENV</key>
        <string>@KURA_ENV@</string>
        <key>KURA_DATA_DIR</key>
        <string>@KURA_DATA_DIR@</string>
        <key>KURA_BIND_ADDR</key>
        <string>@KURA_BIND_ADDR@</string>
        <key>KURA_VERSION</key>
        <string>@KURA_VERSION@</string>
        <key>KURA_LOG_LEVEL</key>
        <string>@KURA_LOG_LEVEL@</string>
        <!-- Live connectors default off so the daemon boots without external
             credentials; opt in at install time (see install.sh). -->
        <key>KURA_CONNECTORS_DISCORD_ENABLED</key>
        <string>@KURA_DISCORD_ENABLED@</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- Back off if the daemon crash-loops on boot. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>@KURA_LOG_DIR@/daemon.out.log</string>
    <key>StandardErrorPath</key>
    <string>@KURA_LOG_DIR@/daemon.err.log</string>

    <key>WorkingDirectory</key>
    <string>@KURA_DATA_DIR@</string>
</dict>
</plist>
