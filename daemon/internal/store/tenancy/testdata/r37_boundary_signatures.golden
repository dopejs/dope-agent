const StatusBackingOff Status = "backing_off"
const StatusDegraded Status = "degraded"
const StatusFailed Status = "failed"
const StatusHealthy Status = "healthy"
const StatusRegistered Status = "registered"
func (*Supervisor) Get(connectorID string) (Connector, bool)
func (*Supervisor) List() []Connector
func (*Supervisor) Register(input RegisterInput) (Connector, bool, error)
