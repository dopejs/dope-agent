{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/api/integration-diagnostic-result.schema.json",
  "title": "IntegrationDiagnosticResult",
  "type": "object",
  "required": [
    "diagnosticResultId",
    "integrationId",
    "domainKind",
    "providerKind",
    "capability",
    "status",
    "reasonCode",
    "remediationOwner",
    "retrySafety",
    "checkedAt",
    "staleAfter",
    "freshnessState",
    "redactionStatus",
    "retentionExpiresAt"
  ],
  "additionalProperties": false,
  "properties": {
    "diagnosticResultId": { "type": "string" },
    "tenantId": { "type": "string" },
    "integrationId": { "type": "string" },
    "integrationAccountId": { "type": "string" },
    "domainKind": { "type": "string" },
    "providerKind": { "type": "string" },
    "capability": { "type": "string" },
    "status": { "type": "string", "enum": ["unknown", "healthy", "degraded", "blocked", "unsupported"] },
    "reasonCode": { "$ref": "./integration-diagnostic-reason-code.schema.json#/$defs/reasonCodeValue" },
    "remediationOwner": { "$ref": "./integration-diagnostic-reason-code.schema.json#/$defs/remediationOwner" },
    "remediationHint": { "type": "string" },
    "retrySafety": { "$ref": "./integration-diagnostic-reason-code.schema.json#/$defs/retrySafety" },
    "checkedAt": { "type": "string", "format": "date-time" },
    "staleAfter": { "type": "string", "format": "date-time" },
    "freshnessState": { "type": "string", "enum": ["fresh", "stale"] },
    "runId": { "type": "string" },
    "redactionStatus": { "type": "string", "enum": ["redacted", "suppressed", "failed_closed"] },
    "evidenceSummary": { "type": "string" },
    "retentionExpiresAt": { "type": "string", "format": "date-time" },
    "smokeReportId": { "type": "string" },
    "artifactRefs": { "type": "array", "items": { "type": "string" } }
  }
}
