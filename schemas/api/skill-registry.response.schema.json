{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/api/skill-registry.response.schema.json",
  "title": "SkillRegistryResponse",
  "type": "object",
  "required": ["loadedAt", "items", "overlays"],
  "additionalProperties": false,
  "properties": {
    "loadedAt": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "items": { "$ref": "./skill-summary.schema.json" }
    },
    "overlays": {
      "type": "array",
      "items": { "$ref": "./skill-overlay.schema.json" }
    }
  }
}
