{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/api/connector-ingress-message.response.schema.json",
  "title": "ConnectorIngressMessageResponse",
  "type": "object",
  "required": ["ingressId", "connectorId", "outcome", "reasonCode", "redactionStatus", "acceptedAt", "sessionCreated", "runCreated"],
  "additionalProperties": false,
  "properties": {
    "tenantId": { "type": "string" },
    "ingressId": {
      "type": "string"
    },
    "connectorId": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": ["accepted", "ignored", "blocked", "duplicate", "unsupported", "failed"]
    },
    "reasonCode": {
      "type": "string"
    },
    "redactionStatus": {
      "type": "string",
      "enum": ["redacted", "suppressed", "redaction_failed"]
    },
    "acceptedAt": {
      "type": "string",
      "format": "date-time"
    },
    "session": {
      "$ref": "./session-resource.schema.json"
    },
    "sessionCreated": {
      "type": "boolean"
    },
    "run": {
      "$ref": "./run-resource.schema.json"
    },
    "runCreated": {
      "type": "boolean"
    }
  }
}
