{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/api/triage-run-resource.schema.json",
  "title": "TriageRunResource",
  "type": "object",
  "required": ["runId", "policyId", "messageCount", "decisions", "createdAt"],
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["field", "operator", "value"],
      "additionalProperties": false,
      "properties": {
        "field": { "type": "string", "enum": ["sender", "subject", "body", "recipient"] },
        "operator": { "type": "string", "enum": ["contains", "equals", "not_contains"] },
        "value": { "type": "string" }
      }
    },
    "decision": {
      "type": "object",
      "required": ["messageId", "classification", "outcome", "replayCandidate", "decidedAt"],
      "additionalProperties": false,
      "properties": {
        "messageId": { "type": "string" },
        "classification": { "type": "string", "enum": ["urgent", "needs_reply", "fyi", "newsletter", "blocked", "unsupported"] },
        "matchedRuleId": { "type": "string" },
        "matchedEvidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "outcome": { "type": "string", "enum": ["draft_reply", "reminder", "delivery_digest", "no_action"] },
        "defaultApplied": { "type": "boolean" },
        "replayCandidate": { "type": "boolean" },
        "decidedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "properties": {
    "runId": { "type": "string" },
    "policyId": { "type": "string" },
    "environmentScope": { "type": "string", "enum": ["test", "prod"] },
    "messageCount": { "type": "integer", "minimum": 0 },
    "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
