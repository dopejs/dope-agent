{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/api/config.response.schema.json",
  "title": "ConfigResponse",
  "type": "object",
  "required": [
    "bindAddr",
    "dataDir",
    "configFilePath",
    "logLevel",
    "version",
    "llm",
    "redactedFields"
  ],
  "additionalProperties": false,
  "properties": {
    "bindAddr": {
      "type": "string"
    },
    "dataDir": {
      "type": "string"
    },
    "configFilePath": {
      "type": "string"
    },
    "logLevel": {
      "type": "string",
      "enum": ["debug", "info", "warn", "error"]
    },
    "version": {
      "type": "string"
    },
    "llm": {
      "type": "object",
      "required": [
        "defaultProvider",
        "defaultModel",
        "defaultTimeoutMs",
        "defaultMaxRetries",
        "openaiCompatible"
      ],
      "additionalProperties": false,
      "properties": {
        "defaultProvider": {
          "type": "string"
        },
        "defaultModel": {
          "type": "string"
        },
        "defaultTimeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "defaultMaxRetries": {
          "type": "integer",
          "minimum": 0
        },
        "openaiCompatible": {
          "type": "object",
          "required": [
            "configured",
            "baseURL",
            "model",
            "timeoutMs",
            "apiKeyConfigured"
          ],
          "additionalProperties": false,
          "properties": {
            "configured": {
              "type": "boolean"
            },
            "baseURL": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1
            },
            "apiKeyConfigured": {
              "type": "boolean"
            },
            "apiKeyEnv": {
              "type": "string"
            }
          }
        }
      }
    },
    "redactedFields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
