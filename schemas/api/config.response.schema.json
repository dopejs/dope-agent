{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/api/config.response.schema.json",
  "title": "ConfigResponse",
  "type": "object",
  "required": [
    "environment",
    "bindAddr",
    "dataDir",
    "configFilePath",
    "logLevel",
    "version",
    "llm",
    "connectors",
    "mcp",
    "sandbox",
    "redactedFields"
  ],
  "additionalProperties": false,
  "properties": {
    "environment": {
      "type": "string",
      "enum": ["prod", "test"]
    },
    "bindAddr": {
      "type": "string"
    },
    "dataDir": {
      "type": "string"
    },
    "configFilePath": {
      "type": "string"
    },
    "logLevel": {
      "type": "string",
      "enum": ["debug", "info", "warn", "error"]
    },
    "version": {
      "type": "string"
    },
    "llm": {
      "type": "object",
      "required": [
        "defaultProvider",
        "defaultModel",
        "defaultTimeoutMs",
        "defaultMaxRetries",
        "openaiCompatible",
        "claude",
        "codex"
      ],
      "additionalProperties": false,
      "properties": {
        "defaultProvider": {
          "type": "string"
        },
        "defaultModel": {
          "type": "string"
        },
        "defaultTimeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "defaultMaxRetries": {
          "type": "integer",
          "minimum": 0
        },
        "openaiCompatible": {
          "type": "object",
          "required": [
            "configured",
            "baseURL",
            "model",
            "timeoutMs",
            "streamFirstChunkTimeoutMs",
            "streamIdleTimeoutMs",
            "streamMaxDurationMs",
            "apiKeyConfigured"
          ],
          "additionalProperties": false,
          "properties": {
            "configured": {
              "type": "boolean"
            },
            "baseURL": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1
            },
            "streamFirstChunkTimeoutMs": {
              "type": "integer",
              "minimum": 1
            },
            "streamIdleTimeoutMs": {
              "type": "integer",
              "minimum": 1
            },
            "streamMaxDurationMs": {
              "type": "integer",
              "minimum": 0
            },
            "apiKeyConfigured": {
              "type": "boolean"
            },
            "apiKeyEnv": {
              "type": "string"
            }
          }
        },
        "claude": {
          "type": "object",
          "required": ["configured"],
          "additionalProperties": false,
          "properties": {
            "configured": { "type": "boolean" },
            "cliPath": { "type": "string" },
            "defaultModel": { "type": "string" },
            "workDir": { "type": "string" },
            "sandbox": { "$ref": "./sandbox-consumer-view.schema.json" }
          }
        },
        "codex": {
          "type": "object",
          "required": ["configured"],
          "additionalProperties": false,
          "properties": {
            "configured": { "type": "boolean" },
            "cliPath": { "type": "string" },
            "defaultModel": { "type": "string" },
            "workDir": { "type": "string" },
            "sandbox": { "$ref": "./sandbox-consumer-view.schema.json" }
          }
        }
      }
    },
    "connectors": {
      "type": "object",
      "required": ["discord", "telegram", "slack", "matrix"],
      "additionalProperties": false,
      "properties": {
        "discord": {
          "type": "object",
          "required": [
            "enabled",
            "configured",
            "connectorId",
            "displayName",
            "deliveryMode",
            "requireMention",
            "respondInDM",
            "allowedGuildIds",
            "allowedChannelIds",
            "botTokenConfigured",
            "hostedReadiness"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "configured": { "type": "boolean" },
            "connectorId": { "type": "string" },
            "displayName": { "type": "string" },
            "deliveryMode": { "type": "string", "enum": ["gateway"] },
            "requireMention": { "type": "boolean" },
            "respondInDM": { "type": "boolean" },
            "allowedGuildIds": {
              "type": "array",
              "items": { "type": "string" }
            },
            "allowedChannelIds": {
              "type": "array",
              "items": { "type": "string" }
            },
            "botTokenConfigured": { "type": "boolean" },
            "botTokenEnv": { "type": "string" },
            "hostedReadiness": {
              "type": "object",
              "required": [
                "connectorId",
                "displayName",
                "deliveryMode",
                "readinessState",
                "hostedReady",
                "localCompatible",
                "requireMention",
                "respondInDM",
                "botTokenConfigured",
                "redactionStatus"
              ],
              "additionalProperties": false,
              "properties": {
                "tenantId": { "type": "string" },
                "connectorId": { "type": "string" },
                "displayName": { "type": "string" },
                "deliveryMode": { "type": "string", "enum": ["gateway"] },
                "readinessState": {
                  "type": "string",
                  "enum": ["hosted_ready", "degraded_needs_repair", "failed", "disabled"]
                },
                "hostedReady": { "type": "boolean" },
                "localCompatible": { "type": "boolean" },
                "reasonCode": { "type": "string" },
                "requireMention": { "type": "boolean" },
                "respondInDM": { "type": "boolean" },
                "allowedGuildIds": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "allowedChannelIds": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "botTokenConfigured": { "type": "boolean" },
                "redactionStatus": {
                  "type": "string",
                  "enum": ["redacted", "suppressed", "redaction_failed"]
                }
              }
            }
          }
        },
        "telegram": {
          "type": "object",
          "required": [
            "enabled",
            "configured",
            "connectorId",
            "displayName",
            "botTokenConfigured",
            "allowedUserIds",
            "allowedDirectChatIds",
            "allowedGroupIds",
            "hostedReadiness"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "configured": { "type": "boolean" },
            "connectorId": { "type": "string" },
            "displayName": { "type": "string" },
            "botTokenConfigured": { "type": "boolean" },
            "botTokenEnv": { "type": "string" },
            "botUsername": { "type": "string" },
            "allowedUserIds": {
              "type": "array",
              "items": { "type": "string" }
            },
            "allowedDirectChatIds": {
              "type": "array",
              "items": { "type": "string" }
            },
            "allowedGroupIds": {
              "type": "array",
              "items": { "type": "string" }
            },
            "hostedReadiness": {
              "type": "object",
              "required": [
                "connectorId",
                "displayName",
                "terminalState",
                "hostedReady",
                "localCompatible",
                "botTokenConfigured",
                "redactionStatus"
              ],
              "additionalProperties": false,
              "properties": {
                "tenantId": { "type": "string" },
                "connectorId": { "type": "string" },
                "displayName": { "type": "string" },
                "terminalState": {
                  "type": "string",
                  "enum": ["ready", "degraded", "unavailable", "cancelled", "action-required"]
                },
                "hostedReady": { "type": "boolean" },
                "localCompatible": { "type": "boolean" },
                "reasonCode": { "type": "string" },
                "botTokenConfigured": { "type": "boolean" },
                "botUsername": { "type": "string" },
                "allowedUserIds": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "allowedDirectChatIds": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "allowedGroupIds": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "redactionStatus": {
                  "type": "string",
                  "enum": ["redacted", "suppressed", "redaction_failed"]
                }
              }
            }
          }
        },
        "slack": {
          "type": "object",
          "required": [
            "enabled",
            "configured",
            "connectorId",
            "displayName",
            "allowedChannelIds",
            "allowedDMUserIds",
            "allowedDMUserGroups",
            "hostedReadiness"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "configured": { "type": "boolean" },
            "connectorId": { "type": "string" },
            "displayName": { "type": "string" },
            "apiBaseURL": { "type": "string" },
            "botTokenSecretRef": { "type": "string" },
            "workspaceBindingId": { "type": "string" },
            "workspaceId": { "type": "string" },
            "botUserId": { "type": "string" },
            "allowedChannelIds": {
              "type": "array",
              "items": { "type": "string" }
            },
            "allowedDMUserIds": {
              "type": "array",
              "items": { "type": "string" }
            },
            "allowedDMUserGroups": {
              "type": "array",
              "items": { "type": "string" }
            },
            "hostedReadiness": {
              "type": "object",
              "required": [
                "connectorId",
                "displayName",
                "terminalState",
                "hostedReady",
                "localCompatible",
                "redactionStatus"
              ],
              "additionalProperties": false,
              "properties": {
                "tenantId": { "type": "string" },
                "connectorId": { "type": "string" },
                "displayName": { "type": "string" },
                "terminalState": {
                  "type": "string",
                  "enum": ["ready", "degraded", "unavailable", "cancelled", "action-required"]
                },
                "hostedReady": { "type": "boolean" },
                "localCompatible": { "type": "boolean" },
                "reasonCode": { "type": "string" },
                "workspaceBindingId": { "type": "string" },
                "workspaceId": { "type": "string" },
                "botUserId": { "type": "string" },
                "allowedChannelIds": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "allowedDMUserIds": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "allowedDMUserGroups": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "redactionStatus": {
                  "type": "string",
                  "enum": ["redacted", "suppressed", "redaction_failed"]
                }
              }
            }
          }
        },
        "matrix": {
          "type": "object",
          "required": [
            "enabled",
            "configured",
            "connectorId",
            "displayName",
            "botAccessTokenSet",
            "selectedRoomIds",
            "allowedDirectUserIds",
            "configuredCommands",
            "hostedReadiness"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "configured": { "type": "boolean" },
            "connectorId": { "type": "string" },
            "displayName": { "type": "string" },
            "homeserverUrl": { "type": "string" },
            "homeserverId": { "type": "string" },
            "botUserId": { "type": "string" },
            "botAccessTokenSet": { "type": "boolean" },
            "botAccessTokenEnv": { "type": "string" },
            "selectedRoomIds": {
              "type": "array",
              "items": { "type": "string" }
            },
            "allowedDirectUserIds": {
              "type": "array",
              "items": { "type": "string" }
            },
            "configuredCommands": {
              "type": "array",
              "items": { "type": "string" }
            },
            "hostedReadiness": {
              "type": "object",
              "required": [
                "connectorId",
                "displayName",
                "terminalState",
                "hostedReady",
                "localCompatible",
                "botAccessTokenSet",
                "hostedHomeserverPolicy",
                "redactionStatus"
              ],
              "additionalProperties": false,
              "properties": {
                "tenantId": { "type": "string" },
                "connectorId": { "type": "string" },
                "displayName": { "type": "string" },
                "terminalState": {
                  "type": "string",
                  "enum": ["ready", "degraded", "unavailable", "cancelled", "action-required"]
                },
                "hostedReady": { "type": "boolean" },
                "localCompatible": { "type": "boolean" },
                "reasonCode": { "type": "string" },
                "homeserverUrl": { "type": "string" },
                "homeserverId": { "type": "string" },
                "botUserId": { "type": "string" },
                "botAccessTokenSet": { "type": "boolean" },
                "selectedRoomIds": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "allowedDirectUserIds": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "configuredCommands": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "hostedHomeserverPolicy": { "const": "unsupported" },
                "redactionStatus": {
                  "type": "string",
                  "enum": ["redacted", "suppressed", "redaction_failed"]
                }
              }
            }
          }
        }
      }
    },
    "mcp": {
      "type": "object",
      "required": ["servers", "transports"],
      "additionalProperties": false,
      "properties": {
        "servers": {
          "type": "array",
          "items": { "$ref": "./mcp-server-resource.schema.json" }
        },
        "catalog": {
          "type": "array",
          "items": { "$ref": "./mcp-catalog-entry.schema.json" }
        },
        "transports": {
          "type": "array",
          "items": { "$ref": "./mcp-transport-capability.schema.json" }
        }
      }
    },
    "sandbox": {
      "type": "object",
      "required": ["backends"],
      "additionalProperties": false,
      "properties": {
        "backends": {
          "type": "array",
          "items": { "$ref": "./sandbox-backend-capability.schema.json" }
        }
      }
    },
    "redactedFields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
