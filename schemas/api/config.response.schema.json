{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/api/config.response.schema.json",
  "title": "ConfigResponse",
  "type": "object",
  "required": [
    "bindAddr",
    "dataDir",
    "configFilePath",
    "logLevel",
    "version",
    "redactedFields"
  ],
  "additionalProperties": false,
  "properties": {
    "bindAddr": {
      "type": "string"
    },
    "dataDir": {
      "type": "string"
    },
    "configFilePath": {
      "type": "string"
    },
    "logLevel": {
      "type": "string",
      "enum": ["debug", "info", "warn", "error"]
    },
    "version": {
      "type": "string"
    },
    "redactedFields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
