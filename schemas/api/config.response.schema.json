{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/api/config.response.schema.json",
  "title": "ConfigResponse",
  "type": "object",
  "required": [
    "environment",
    "bindAddr",
    "dataDir",
    "configFilePath",
    "logLevel",
    "version",
    "llm",
    "connectors",
    "mcp",
    "redactedFields"
  ],
  "additionalProperties": false,
  "properties": {
    "environment": {
      "type": "string",
      "enum": ["prod", "test"]
    },
    "bindAddr": {
      "type": "string"
    },
    "dataDir": {
      "type": "string"
    },
    "configFilePath": {
      "type": "string"
    },
    "logLevel": {
      "type": "string",
      "enum": ["debug", "info", "warn", "error"]
    },
    "version": {
      "type": "string"
    },
    "llm": {
      "type": "object",
      "required": [
        "defaultProvider",
        "defaultModel",
        "defaultTimeoutMs",
        "defaultMaxRetries",
        "openaiCompatible",
        "claude",
        "codex"
      ],
      "additionalProperties": false,
      "properties": {
        "defaultProvider": {
          "type": "string"
        },
        "defaultModel": {
          "type": "string"
        },
        "defaultTimeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "defaultMaxRetries": {
          "type": "integer",
          "minimum": 0
        },
        "openaiCompatible": {
          "type": "object",
          "required": [
            "configured",
            "baseURL",
            "model",
            "timeoutMs",
            "streamFirstChunkTimeoutMs",
            "streamIdleTimeoutMs",
            "streamMaxDurationMs",
            "apiKeyConfigured"
          ],
          "additionalProperties": false,
          "properties": {
            "configured": {
              "type": "boolean"
            },
            "baseURL": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1
            },
            "streamFirstChunkTimeoutMs": {
              "type": "integer",
              "minimum": 1
            },
            "streamIdleTimeoutMs": {
              "type": "integer",
              "minimum": 1
            },
            "streamMaxDurationMs": {
              "type": "integer",
              "minimum": 0
            },
            "apiKeyConfigured": {
              "type": "boolean"
            },
            "apiKeyEnv": {
              "type": "string"
            }
          }
        },
        "claude": {
          "type": "object",
          "required": ["configured"],
          "additionalProperties": false,
          "properties": {
            "configured": { "type": "boolean" },
            "cliPath": { "type": "string" },
            "defaultModel": { "type": "string" },
            "workDir": { "type": "string" },
            "sandbox": { "$ref": "./sandbox-consumer-view.schema.json" }
          }
        },
        "codex": {
          "type": "object",
          "required": ["configured"],
          "additionalProperties": false,
          "properties": {
            "configured": { "type": "boolean" },
            "cliPath": { "type": "string" },
            "defaultModel": { "type": "string" },
            "workDir": { "type": "string" },
            "sandbox": { "$ref": "./sandbox-consumer-view.schema.json" }
          }
        }
      }
    },
    "connectors": {
      "type": "object",
      "required": ["discord"],
      "additionalProperties": false,
      "properties": {
        "discord": {
          "type": "object",
          "required": [
            "enabled",
            "configured",
            "connectorId",
            "displayName",
            "deliveryMode",
            "requireMention",
            "respondInDM",
            "allowedGuildIds",
            "allowedChannelIds",
            "botTokenConfigured"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "configured": { "type": "boolean" },
            "connectorId": { "type": "string" },
            "displayName": { "type": "string" },
            "deliveryMode": { "type": "string", "enum": ["gateway"] },
            "requireMention": { "type": "boolean" },
            "respondInDM": { "type": "boolean" },
            "allowedGuildIds": {
              "type": "array",
              "items": { "type": "string" }
            },
            "allowedChannelIds": {
              "type": "array",
              "items": { "type": "string" }
            },
            "botTokenConfigured": { "type": "boolean" },
            "botTokenEnv": { "type": "string" }
          }
        }
      }
    },
    "mcp": {
      "type": "object",
      "required": ["servers"],
      "additionalProperties": false,
      "properties": {
        "servers": {
          "type": "array",
          "items": { "$ref": "./mcp-server-resource.schema.json" }
        }
      }
    },
    "redactedFields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
