{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/api/tenant-audit-event-resource.schema.json",
  "title": "TenantAuditEventResource",
  "type": "object",
  "required": ["auditEventId", "eventKind", "outcome", "reasonCode", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "auditEventId": { "type": "string" },
    "eventKind": { "type": "string" },
    "tenantId": { "type": "string" },
    "principalId": { "type": "string" },
    "targetPrincipalId": { "type": "string" },
    "tokenId": { "type": "string" },
    "outcome": { "type": "string", "enum": ["succeeded", "denied", "failed_closed"] },
    "reasonCode": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "document": { "type": "object", "additionalProperties": true }
  }
}
