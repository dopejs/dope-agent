{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/api/tenant-audit-event-resource.schema.json",
  "title": "TenantAuditEventResource",
  "type": "object",
  "required": ["auditEventId", "eventKind", "outcome", "reasonCode", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "auditEventId": { "type": "string" },
    "eventKind": { "type": "string" },
    "tenantId": { "type": "string" },
    "principalId": { "type": "string" },
    "targetPrincipalId": { "type": "string" },
    "tokenId": { "type": "string" },
    "outcome": { "type": "string", "enum": ["succeeded", "denied", "failed_closed"] },
    "reasonCode": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "document": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "resourceKind": { "type": "string" },
        "resourceId": { "type": "string" },
        "action": { "type": "string" },
        "secretRef": { "type": "string" },
        "secretVersionId": { "type": "string" },
        "secretRefCount": { "type": "integer", "minimum": 0 },
        "secretRefs": {
          "type": "array",
          "items": { "$ref": "./tenant-secret-resource.schema.json#/$defs/redactedSecretSummary" }
        }
      }
    }
  }
}
