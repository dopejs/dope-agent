{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/api/snooze-reminder.request.schema.json",
  "title": "SnoozeReminderRequest",
  "type": "object",
  "required": ["snoozedUntil"],
  "additionalProperties": false,
  "properties": {
    "occurrenceId": { "type": "string" },
    "reason": { "type": "string" },
    "actorKind": { "type": "string", "enum": ["system", "user", "reminder"] },
    "snoozedUntil": { "type": "string", "format": "date-time" }
  }
}
