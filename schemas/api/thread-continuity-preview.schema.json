{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dope.agent/api/thread-continuity-preview.schema.json",
  "title": "ThreadContinuityPreview",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "continuityPreviewId",
    "threadId",
    "sessionSegmentId",
    "windowPolicyId",
    "maxPriorTurns",
    "activeWindowDays",
    "continuityApplied",
    "status",
    "includedCount",
    "excludedCount",
    "assemblyDurationMs",
    "redactionStatus"
  ],
  "properties": {
    "continuityPreviewId": { "type": "string", "minLength": 1 },
    "tenantId": { "type": "string", "minLength": 1 },
    "threadId": { "type": "string", "minLength": 1 },
    "sessionSegmentId": { "type": "string", "minLength": 1 },
    "dispatchId": { "type": "string" },
    "requestTurnId": { "type": "string" },
    "responseTurnId": { "type": "string" },
    "windowPolicyId": { "type": "string", "minLength": 1 },
    "maxPriorTurns": { "type": "integer", "minimum": 0 },
    "activeWindowDays": { "type": "integer", "minimum": 0 },
    "orderedBy": { "type": "string" },
    "continuityApplied": { "type": "boolean" },
    "status": { "type": "string", "enum": ["applied", "empty", "disabled", "blocked", "partial", "failed"] },
    "failureClass": { "type": "string" },
    "includedCount": { "type": "integer", "minimum": 0 },
    "excludedCount": { "type": "integer", "minimum": 0 },
    "assemblyStartedAt": { "type": "string", "format": "date-time" },
    "assemblyCompletedAt": { "type": "string", "format": "date-time" },
    "assemblyDurationMs": { "type": "integer", "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" },
    "retentionExpiresAt": { "type": "string", "format": "date-time" },
    "redactionStatus": { "type": "string", "enum": ["redacted", "suppressed", "redaction_failed"] }
  }
}
