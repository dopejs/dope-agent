{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/api/create-tool-call.request.schema.json",
  "title": "CreateToolCallRequest",
  "type": "object",
  "required": ["toolName"],
  "additionalProperties": false,
  "anyOf": [
    { "required": ["capabilityId"] },
    { "required": ["skillId"] },
    { "required": ["mcpServerId"] }
  ],
  "properties": {
    "capabilityId": {
      "type": "string"
    },
    "skillId": {
      "type": "string"
    },
    "mcpServerId": {
      "type": "string"
    },
    "toolName": {
      "type": "string"
    },
    "approvalId": {
      "type": "string"
    },
    "runtimeSurface": {
      "type": "string"
    },
    "input": {
      "type": ["object", "array", "string", "number", "boolean", "null"]
    }
  }
}
