{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dope.agent/api/thread-handoff-link.schema.json",
  "title": "ThreadHandoffLink",
  "type": "object",
  "additionalProperties": false,
  "required": ["sourceThreadId", "destinationThreadId", "sourceConversationShape", "destinationConversationShape", "status", "sourceReferenceStatus", "permissionGate", "redactionStatus"],
  "properties": {
    "handoffLinkId": { "type": "string" },
    "tenantId": { "type": "string" },
    "sourceThreadId": { "type": "string", "minLength": 1 },
    "sourceSessionSegmentId": { "type": "string" },
    "destinationThreadId": { "type": "string", "minLength": 1 },
    "destinationSessionSegmentId": { "type": "string" },
    "sourceConversationShape": { "type": "string", "enum": ["direct_message", "group", "room", "web", "unknown", "unsupported"] },
    "destinationConversationShape": { "type": "string", "enum": ["direct_message", "group", "room", "web", "unknown", "unsupported"] },
    "sourceKind": { "type": "string" },
    "destinationKind": { "type": "string" },
    "sourceConnectorId": { "type": "string" },
    "destinationConnectorId": { "type": "string" },
    "sourceConversationId": { "type": "string" },
    "destinationConversationId": { "type": "string" },
    "actorPrincipalId": { "type": "string" },
    "permissionGate": { "type": "string", "const": "connectors.manage" },
    "status": { "type": "string", "enum": ["succeeded", "denied", "failed_closed", "unsupported", "expired"] },
    "reasonCode": { "type": "string" },
    "firstDestinationResponseId": { "type": "string" },
    "sourceReferenceStatus": { "type": "string", "enum": ["available", "consumed", "blocked", "expired", "none"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "consumedAt": { "type": "string", "format": "date-time" },
    "retentionExpiresAt": { "type": "string", "format": "date-time" },
    "redactionStatus": { "type": "string", "enum": ["redacted", "suppressed", "redaction_failed"] }
  }
}
