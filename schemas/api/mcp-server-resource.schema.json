{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/api/mcp-server-resource.schema.json",
  "title": "MCPServerResource",
  "type": "object",
  "required": [
    "serverId",
    "displayName",
    "source",
    "enabled",
    "sandboxProfileId",
    "declarationId",
    "declaration",
    "transportKind",
    "autoRestart",
    "createdAt",
    "updatedAt",
    "state",
    "toolCount"
  ],
  "additionalProperties": false,
  "properties": {
    "serverId": { "type": "string" },
    "displayName": { "type": "string" },
    "source": { "type": "string", "enum": ["api", "config", "builtin"] },
    "originKind": { "type": "string", "enum": ["manual", "catalog"] },
    "catalogEntryId": { "type": "string" },
    "installMethod": { "type": "string", "enum": ["api", "script"] },
    "environmentScope": { "type": "string", "enum": ["test", "prod"] },
    "catalogManagement": {
      "type": "object",
      "required": ["sourceKind", "installedRevision", "currentRevision", "driftStatus"],
      "additionalProperties": false,
      "properties": {
        "sourceKind": { "type": "string" },
        "installedRevision": { "type": "string" },
        "currentRevision": { "type": "string" },
        "driftStatus": { "type": "string", "enum": ["in_sync", "catalog_updated", "locally_modified", "missing_entry", "conflicting"] },
        "driftReason": { "type": "string" },
        "installedAt": { "type": "string", "format": "date-time" },
        "lastMaintainedAt": { "type": "string", "format": "date-time" },
        "lastActionAt": { "type": "string", "format": "date-time" },
        "lastAction": { "type": "string", "enum": ["install", "refresh", "reinstall", "uninstall", "revalidate"] },
        "lastActionStatus": { "type": "string", "enum": ["completed", "blocked", "failed"] },
        "lastActionFailureClass": { "type": "string" },
        "lastActionReason": { "type": "string" },
        "installInputSnapshot": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "serverId": { "type": "string" },
            "displayName": { "type": "string" },
            "enabled": { "type": "boolean" },
            "sandboxProfileId": { "type": "string" },
            "command": { "type": "string" },
            "args": { "type": "array", "items": { "type": "string" } },
            "endpoint": { "type": "string" },
            "workingDir": { "type": "string" },
            "secretRefs": { "type": "array", "items": { "type": "string" } },
            "installMethod": { "type": "string", "enum": ["api", "script"] }
          }
        },
        "lastRevalidation": {
          "type": "object",
          "required": ["checkedAt", "status", "classification"],
          "additionalProperties": false,
          "properties": {
            "checkedAt": { "type": "string", "format": "date-time" },
            "status": { "type": "string", "enum": ["ready", "blocked", "unavailable", "unsupported"] },
            "classification": { "type": "string", "enum": ["healthy", "prerequisite_lost", "catalog_drift", "locally_modified", "runtime_unhealthy", "missing_entry"] },
            "reason": { "type": "string" },
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["kind", "name", "status", "reason"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "type": "string" },
                  "name": { "type": "string" },
                  "status": { "type": "string", "enum": ["blocked", "unavailable", "unsupported", "warning"] },
                  "reason": { "type": "string" },
                  "environmentScope": { "type": "string", "enum": ["test", "prod"] }
                }
              }
            }
          }
        }
      }
    },
    "enabled": { "type": "boolean" },
    "sandboxProfileId": { "type": "string" },
    "declarationId": { "type": "string" },
    "declaration": { "$ref": "./mcp-declaration.schema.json" },
    "transportKind": { "type": "string", "enum": ["stdio", "streamable-http", "websocket"] },
    "command": { "type": "string" },
    "args": {
      "type": "array",
      "items": { "type": "string" }
    },
    "endpoint": { "type": "string" },
    "websocketConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subprotocols": {
          "type": "array",
          "items": { "type": "string" }
        },
        "auth": {
          "type": "object",
          "required": ["mode", "secretRef"],
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string", "enum": ["bearer_header", "header"] },
            "headerName": { "type": "string" },
            "scheme": { "type": "string" },
            "secretRef": { "type": "string" }
          }
        }
      }
    },
    "workingDir": { "type": "string" },
    "secretRefs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "autoRestart": { "type": "boolean" },
    "operatorModified": { "type": "boolean" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "state": {
      "type": "object",
      "required": ["serverId", "status", "failureCount", "restartCount", "updatedAt"],
      "additionalProperties": false,
      "properties": {
        "serverId": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["disabled", "stopped", "starting", "healthy", "degraded", "backing_off", "failed", "stopping", "denied", "unsupported"]
        },
        "healthReason": { "type": "string" },
        "failureCount": { "type": "integer", "minimum": 0 },
        "restartCount": { "type": "integer", "minimum": 0 },
        "lastSessionId": { "type": "string" },
        "lastRecoveryAt": { "type": "string", "format": "date-time" },
        "lastRecoveryClass": { "type": "string" },
        "reconnectAttemptCount": { "type": "integer", "minimum": 0 },
        "lastStartedAt": { "type": "string", "format": "date-time" },
        "lastStoppedAt": { "type": "string", "format": "date-time" },
        "lastHeartbeatAt": { "type": "string", "format": "date-time" },
        "nextRestartAt": { "type": "string", "format": "date-time" },
        "nextReconnectAt": { "type": "string", "format": "date-time" },
        "lastExecutionId": { "type": "string" },
        "lastPolicyRecordId": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "transportConfigSummary": { "type": "string" },
    "websocketAuthSummary": {
      "type": "object",
      "required": ["configured", "resolved"],
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["bearer_header", "header"] },
        "headerName": { "type": "string" },
        "scheme": { "type": "string" },
        "secretRef": { "type": "string" },
        "configured": { "type": "boolean" },
        "resolved": { "type": "boolean" },
        "blockedReason": { "type": "string" }
      }
    },
    "availabilityStatus": { "type": "string", "enum": ["ready", "blocked", "unavailable", "unsupported"] },
    "availabilityReason": { "type": "string" },
    "secretSummary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["consumerId", "secretRef", "environmentScope", "resolution"],
        "additionalProperties": false,
        "properties": {
          "consumerId": { "type": "string" },
          "secretRef": { "type": "string" },
          "environmentScope": { "type": "string", "enum": ["test", "prod", "both"] },
          "defaultRuleId": { "type": "string" },
          "resolution": { "type": "string", "enum": ["resolved", "denied", "unavailable", "not_applicable"] },
          "deliveryKind": { "type": "string" },
          "redactionRule": { "type": "string" }
        }
      }
    },
    "toolCount": { "type": "integer", "minimum": 0 },
    "tools": {
      "type": "array",
      "items": { "$ref": "./mcp-tool-resource.schema.json" }
    }
  },
  "anyOf": [
    {
      "properties": { "transportKind": { "const": "stdio" } },
      "required": ["command", "args"]
    },
    {
      "properties": { "transportKind": { "const": "streamable-http" } },
      "required": ["endpoint"]
    },
    {
      "properties": { "transportKind": { "const": "websocket" } },
      "required": ["endpoint", "websocketConfig"]
    }
  ]
}
