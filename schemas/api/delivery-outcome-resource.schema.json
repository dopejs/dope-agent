{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/api/delivery-outcome-resource.schema.json",
  "title": "DeliveryOutcomeResource",
  "type": "object",
  "required": ["deliveryId", "environmentScope", "sourceKind", "sourceId", "resultClass", "mode", "status", "createdAt", "updatedAt"],
  "additionalProperties": false,
  "properties": {
    "tenantId": { "type": "string" },
    "deliveryId": { "type": "string" },
    "environmentScope": { "type": "string", "enum": ["test", "prod"] },
    "sourceKind": { "type": "string" },
    "sourceId": { "type": "string" },
    "runId": { "type": "string" },
    "workflowId": { "type": "string" },
    "scheduleId": { "type": "string" },
    "scheduleAttemptId": { "type": "string" },
    "integrationId": { "type": "string" },
    "resultClass": { "type": "string", "enum": ["routine_success", "urgent", "failure"] },
    "mode": { "type": "string", "enum": ["immediate", "digest", "suppressed"] },
    "status": { "type": "string", "enum": ["pending", "queued", "dispatching", "delivered", "suppressed", "failed"] },
    "chosenTargetId": { "type": "string" },
    "preferenceId": { "type": "string" },
    "summaryWindowId": { "type": "string" },
    "payloadPreview": { "type": "string" },
    "suppressionReason": { "type": "string" },
    "calendarOperationIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "calendarOperationSummaries": {
      "type": "array",
      "items": { "$ref": "./calendar-operation-summary.schema.json" }
    },
    "mailOperationIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "mailOperationSummaries": {
      "type": "array",
      "items": { "$ref": "./mail-operation-summary.schema.json" }
    },
    "attempts": {
      "type": "array",
      "items": { "$ref": "./delivery-attempt-resource.schema.json" }
    },
    "diagnosticFailure": { "$ref": "./integration-diagnostic-failure-projection.schema.json" },
    "connectorDeliveryLinkage": {
      "type": "object",
      "required": ["connectorId", "transportKind", "separationStatus"],
      "additionalProperties": false,
      "properties": {
        "connectorId": { "type": "string" },
        "connectorMessageDeliveryId": { "type": "string" },
        "foregroundReplyOutcomeId": { "type": "string" },
        "backgroundDeliveryId": { "type": "string" },
        "transportKind": { "type": "string" },
        "separationStatus": { "type": "string" },
        "redactionStatus": {
          "type": "string",
          "enum": ["redacted", "suppressed", "redaction_failed"]
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "finalizedAt": { "type": "string", "format": "date-time" }
  }
}
