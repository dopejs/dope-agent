{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/api/sandbox-access-request.schema.json",
  "title": "SandboxAccessRequest",
  "type": "object",
  "required": ["readRoots", "writeRoots", "allowedHosts", "allowedPorts"],
  "additionalProperties": false,
  "properties": {
    "tenantId": { "type": "string" },
    "readRoots": {
      "type": "array",
      "items": { "type": "string" }
    },
    "writeRoots": {
      "type": "array",
      "items": { "type": "string" }
    },
    "networkMode": {
      "type": "string",
      "enum": ["deny", "allow_list", "full"]
    },
    "allowedHosts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "allowedPorts": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 }
    },
    "allowLoopback": { "type": "boolean" }
  }
}
