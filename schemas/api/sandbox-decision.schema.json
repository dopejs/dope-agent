{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/api/sandbox-decision.schema.json",
  "title": "SandboxDecision",
  "type": "object",
  "required": [
    "decisionId",
    "resolution",
    "matchedRules",
    "approvalRequired",
    "approvalStatus",
    "selectionOutcome",
    "effectiveProfileId",
    "effectiveBackendKind",
    "hostStatus",
    "explanation"
  ],
  "additionalProperties": false,
  "properties": {
    "decisionId": { "type": "string" },
    "executionId": { "type": "string" },
    "resolution": {
      "type": "string",
      "enum": ["allow", "ask", "deny"]
    },
    "selectionOutcome": {
      "type": "string",
      "enum": ["selected", "unsupported", "denied"]
    },
    "matchedRules": {
      "type": "array",
      "items": { "type": "string" }
    },
    "approvalRequired": { "type": "boolean" },
    "approvalStatus": {
      "type": "string",
      "enum": ["not_applicable", "pending", "approved", "rejected"]
    },
    "effectiveProfileId": { "type": "string" },
    "effectiveBackendKind": {
      "type": "string",
      "enum": ["subprocess", "docker", "ssh", "remote"]
    },
    "requiredBackendKind": {
      "type": "string",
      "enum": ["subprocess", "docker", "ssh", "remote"]
    },
    "hostStatus": {
      "type": "string",
      "enum": ["ready", "missing_prerequisite", "runtime_unavailable"]
    },
    "mismatchReason": { "type": "string" },
    "explanation": { "type": "string" },
    "consumer": { "$ref": "./sandbox-consumer-view.schema.json" }
  }
}
