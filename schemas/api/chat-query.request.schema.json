{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/api/chat-query.request.schema.json",
  "title": "ChatQueryRequest",
  "type": "object",
  "required": ["query"],
  "additionalProperties": false,
  "properties": {
    "provider": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1
    },
    "maxRetries": {
      "type": "integer",
      "minimum": 0
    },
    "threadId": {
      "type": "string",
      "minLength": 1
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["auto", "disabled"]
        }
      }
    }
  }
}
