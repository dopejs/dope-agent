{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/api/chat-query.request.schema.json",
  "title": "ChatQueryRequest",
  "type": "object",
  "required": ["query"],
  "additionalProperties": false,
  "properties": {
    "provider": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1
    },
    "maxRetries": {
      "type": "integer",
      "minimum": 0
    }
  }
}
