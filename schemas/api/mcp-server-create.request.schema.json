{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/api/mcp-server-create.request.schema.json",
  "title": "MCPServerCreateRequest",
  "type": "object",
  "required": [
    "serverId",
    "displayName",
    "enabled",
    "sandboxProfileId",
    "declarationId",
    "transportKind",
    "command",
    "args",
    "autoRestart"
  ],
  "additionalProperties": false,
  "properties": {
    "serverId": { "type": "string" },
    "displayName": { "type": "string" },
    "enabled": { "type": "boolean" },
    "sandboxProfileId": { "type": "string" },
    "declarationId": { "type": "string" },
    "declaration": { "$ref": "./mcp-declaration.schema.json" },
    "transportKind": { "type": "string", "enum": ["stdio"] },
    "command": { "type": "string" },
    "args": {
      "type": "array",
      "items": { "type": "string" }
    },
    "workingDir": { "type": "string" },
    "secretRefs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "autoRestart": { "type": "boolean" }
  }
}
