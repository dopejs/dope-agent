{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/api/mcp-server-create.request.schema.json",
  "title": "MCPServerCreateRequest",
  "type": "object",
  "required": [
    "serverId",
    "displayName",
    "enabled",
    "sandboxProfileId",
    "declarationId",
    "transportKind",
    "autoRestart"
  ],
  "additionalProperties": false,
  "properties": {
    "serverId": { "type": "string" },
    "displayName": { "type": "string" },
    "enabled": { "type": "boolean" },
    "sandboxProfileId": { "type": "string" },
    "declarationId": { "type": "string" },
    "declaration": { "$ref": "./mcp-declaration.schema.json" },
    "transportKind": { "type": "string", "enum": ["stdio", "streamable-http", "websocket"] },
    "command": { "type": "string" },
    "args": {
      "type": "array",
      "items": { "type": "string" }
    },
    "endpoint": { "type": "string" },
    "websocketConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subprotocols": {
          "type": "array",
          "items": { "type": "string" }
        },
        "auth": {
          "type": "object",
          "required": ["mode", "secretRef"],
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string", "enum": ["bearer_header", "header"] },
            "headerName": { "type": "string" },
            "scheme": { "type": "string" },
            "secretRef": { "type": "string" }
          }
        }
      }
    },
    "workingDir": { "type": "string" },
    "secretRefs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "autoRestart": { "type": "boolean" }
  },
  "anyOf": [
    {
      "properties": { "transportKind": { "const": "stdio" } },
      "required": ["command", "args"]
    },
    {
      "properties": { "transportKind": { "const": "streamable-http" } },
      "required": ["endpoint"]
    },
    {
      "properties": { "transportKind": { "const": "websocket" } },
      "required": ["endpoint", "websocketConfig"]
    }
  ]
}
