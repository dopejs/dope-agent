{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/api/run-resource.schema.json",
  "title": "RunResource",
  "type": "object",
  "required": [
    "runId",
    "entrypoint",
    "status",
    "goal",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "tenantId": { "type": "string" },
    "runId": {
      "type": "string"
    },
    "sessionId": {
      "type": "string"
    },
    "scheduleId": {
      "type": "string"
    },
    "scheduleAttemptId": {
      "type": "string"
    },
    "reminderId": {
      "type": "string"
    },
    "reminderOccurrenceId": {
      "type": "string"
    },
    "entrypoint": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "waiting_input",
        "blocked",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "goal": {
      "type": "string"
    },
    "activeWorkflowId": {
      "type": "string"
    },
    "workflowCount": {
      "type": "integer",
      "minimum": 0
    },
    "latestDeliveryId": {
      "type": "string"
    },
    "latestDeliveryStatus": {
      "type": "string",
      "enum": [
        "pending",
        "queued",
        "dispatching",
        "delivered",
        "suppressed",
        "failed"
      ]
    },
    "latestDeliveryTargetId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
