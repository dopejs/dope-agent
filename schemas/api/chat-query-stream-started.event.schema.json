{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/api/chat-query-stream-started.event.schema.json",
  "title": "ChatQueryStreamStarted",
  "type": "object",
  "required": ["dispatchId", "provider", "model", "skills", "query"],
  "additionalProperties": false,
  "properties": {
    "dispatchId": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": { "type": "string" }
    },
    "skillContracts": {
      "type": "array",
      "items": {
        "$ref": "./sandbox-consumer-view.schema.json"
      }
    },
    "query": {
      "type": "string"
    },
    "threadId": {
      "type": "string"
    },
    "sessionSegmentId": {
      "type": "string"
    },
    "requestTurnId": {
      "type": "string"
    },
    "continuityPreviewId": {
      "type": "string"
    },
    "continuityApplied": {
      "type": "boolean"
    },
    "continuityStatus": {
      "type": "string",
      "enum": ["applied", "empty", "disabled", "blocked", "partial", "failed"]
    }
  }
}
