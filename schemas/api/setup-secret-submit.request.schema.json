{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/api/setup-secret-submit.request.schema.json",
  "title": "SetupSecretSubmitRequest",
  "type": "object",
  "required": ["secretRef", "value"],
  "additionalProperties": false,
  "properties": {
    "secretRef": { "type": "string", "minLength": 1 },
    "value": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string" },
    "resourceRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "id"],
        "additionalProperties": false,
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "id": { "type": "string", "minLength": 1 },
          "route": { "type": "string" }
        }
      }
    }
  }
}
