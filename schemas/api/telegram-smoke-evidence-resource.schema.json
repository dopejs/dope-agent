{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/api/telegram-smoke-evidence-resource.schema.json",
  "title": "TelegramSmokeEvidenceResource",
  "type": "object",
  "required": [
    "smokeEvidenceId",
    "connectorId",
    "status",
    "credentialMode",
    "owner",
    "reason",
    "validatedAt",
    "retentionExpiresAt",
    "redactionStatus"
  ],
  "additionalProperties": false,
  "properties": {
    "smokeEvidenceId": { "type": "string" },
    "tenantId": { "type": "string" },
    "connectorId": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["passed", "failed", "skipped"]
    },
    "credentialMode": {
      "type": "string",
      "enum": ["safe_live", "fake", "unavailable"]
    },
    "owner": { "type": "string" },
    "reason": { "type": "string" },
    "remainingRisk": { "type": "string" },
    "validatedAt": { "type": "string", "format": "date-time" },
    "retentionExpiresAt": { "type": "string", "format": "date-time" },
    "redactionStatus": {
      "type": "string",
      "enum": ["redacted", "suppressed", "redaction_failed"]
    },
    "safeEvidence": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
