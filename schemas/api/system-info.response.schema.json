{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/api/system-info.response.schema.json",
  "title": "SystemInfoResponse",
  "type": "object",
  "required": ["service", "version", "bindAddr", "dataDir", "logLevel"],
  "additionalProperties": false,
  "properties": {
    "service": {
      "type": "string",
      "const": "dope"
    },
    "version": {
      "type": "string"
    },
    "bindAddr": {
      "type": "string"
    },
    "dataDir": {
      "type": "string"
    },
    "logLevel": {
      "type": "string",
      "enum": ["debug", "info", "warn", "error"]
    }
  }
}
