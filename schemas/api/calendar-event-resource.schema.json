{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/api/calendar-event-resource.schema.json",
  "title": "CalendarEventResource",
  "type": "object",
  "required": [
    "externalEventId",
    "integrationId",
    "calendarAccountId",
    "calendarRef",
    "title",
    "startsAt",
    "endsAt",
    "timezone",
    "mutationEligibleInPhase",
    "lifecycleState",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "tenantId": { "type": "string" },
    "externalEventId": { "type": "string" },
    "integrationId": { "type": "string" },
    "calendarAccountId": { "type": "string" },
    "calendarRef": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "location": { "type": "string" },
    "startsAt": { "type": "string", "format": "date-time" },
    "endsAt": { "type": "string", "format": "date-time" },
    "timezone": { "type": "string" },
    "allDay": { "type": "boolean" },
    "recurring": { "type": "boolean" },
    "recurrenceSummary": { "type": "string" },
    "attendees": {
      "type": "array",
      "items": { "type": "string" }
    },
    "attendeeDetails": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": { "type": "string" },
          "displayName": { "type": "string" },
          "role": { "type": "string", "enum": ["required", "optional"] },
          "rsvp": { "type": "string", "enum": ["needs_action", "accepted", "declined", "tentative", "unknown"] },
          "invitationStatus": { "type": "string", "enum": ["not_requested", "sent", "blocked", "failed", "unsupported"] },
          "diagnostic": { "type": "string" }
        }
      }
    },
    "mutationEligibleInPhase": { "type": "boolean" },
    "lifecycleState": {
      "type": "string",
      "enum": ["active", "cancelled", "stale_snapshot", "unavailable"]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "cancelledAt": { "type": "string", "format": "date-time" }
  }
}
