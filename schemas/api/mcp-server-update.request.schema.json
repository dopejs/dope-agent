{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/api/mcp-server-update.request.schema.json",
  "title": "MCPServerUpdateRequest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "displayName": { "type": "string" },
    "enabled": { "type": "boolean" },
    "sandboxProfileId": { "type": "string" },
    "declarationId": { "type": "string" },
    "declaration": { "$ref": "./mcp-declaration.schema.json" },
    "transportKind": { "type": "string", "enum": ["stdio", "streamable-http"] },
    "command": { "type": "string" },
    "args": {
      "type": "array",
      "items": { "type": "string" }
    },
    "endpoint": { "type": "string" },
    "workingDir": { "type": "string" },
    "secretRefs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "autoRestart": { "type": "boolean" }
  }
}
