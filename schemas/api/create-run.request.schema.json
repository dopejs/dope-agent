{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/api/create-run.request.schema.json",
  "title": "CreateRunRequest",
  "type": "object",
  "required": ["entrypoint"],
  "additionalProperties": false,
  "properties": {
    "tenantId": { "type": "string" },
    "sessionId": {
      "type": "string"
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["direct", "group"]
        },
        "channel": {
          "type": "string"
        },
        "accountId": {
          "type": "string"
        },
        "peerId": {
          "type": "string"
        },
        "threadId": {
          "type": "string"
        }
      },
      "required": ["channel", "peerId"],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "group"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["threadId"]
          }
        }
      ]
    },
    "entrypoint": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "input": {
      "type": ["object", "array", "string", "number", "boolean", "null"]
    }
  },
  "not": {
    "required": ["sessionId", "route"]
  }
}
