{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/api/mail-operation-resource.schema.json",
  "title": "MailOperationResource",
  "type": "object",
  "required": ["operationId", "operationClass", "status", "resultMode", "integrationId", "mailAccountId", "environmentScope", "createdAt", "updatedAt"],
  "additionalProperties": false,
  "properties": {
    "tenantId": { "type": "string" },
    "operationId": { "type": "string" },
    "operationClass": { "type": "string", "enum": ["list_threads", "get_thread", "get_message", "list_drafts", "get_draft", "create_draft", "update_draft", "send_message", "send_draft", "reply_message", "forward_message", "download_attachment"] },
    "status": { "type": "string", "enum": ["requested", "completed", "failed", "blocked", "cancelled"] },
    "resultMode": { "type": "string", "enum": ["inspection", "draft_only", "sent", "blocked", "failed"] },
    "sendPath": { "type": "string", "enum": ["direct", "draft"] },
    "integrationId": { "type": "string" },
    "mailAccountId": { "type": "string" },
    "environmentScope": { "type": "string", "enum": ["test", "prod"] },
    "selectionMode": { "type": "string", "enum": ["explicit", "canonical_default"] },
    "threadId": { "type": "string" },
    "messageId": { "type": "string" },
    "draftId": { "type": "string" },
    "requestSummary": { "type": "string" },
    "failureClass": { "type": "string" },
    "failureReason": { "type": "string" },
    "diagnosticFailure": { "$ref": "./integration-diagnostic-failure-projection.schema.json" },
    "backgroundSendPermitted": { "type": "boolean" },
    "runId": { "type": "string" },
    "stepId": { "type": "string" },
    "toolCallId": { "type": "string" },
    "workflowId": { "type": "string" },
    "workflowStepId": { "type": "string" },
    "scheduleId": { "type": "string" },
    "scheduleAttemptId": { "type": "string" },
    "deliveryId": { "type": "string" },
    "artifactIds": { "type": "array", "items": { "type": "string" } },
    "createdAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
