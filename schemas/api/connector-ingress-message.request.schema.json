{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/api/connector-ingress-message.request.schema.json",
  "title": "ConnectorIngressMessageRequest",
  "type": "object",
  "required": ["route", "message"],
  "additionalProperties": false,
  "properties": {
    "tenantId": { "type": "string" },
    "route": {
      "type": "object",
      "required": ["peerId"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["direct", "group"]
        },
        "accountId": {
          "type": "string"
        },
        "peerId": {
          "type": "string"
        },
        "threadId": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "group"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["threadId"]
          }
        }
      ]
    },
    "message": {
      "type": "object",
      "required": ["messageId"],
      "additionalProperties": false,
      "properties": {
        "messageId": {
          "type": "string"
        },
        "connectorAccountId": {
          "type": "string"
        },
        "channelOrConversationId": {
          "type": "string"
        },
        "providerMessageId": {
          "type": "string"
        },
        "equivalentRuleId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "payload": {
          "type": ["object", "array", "string", "number", "boolean", "null"]
        }
      }
    },
    "run": {
      "type": "object",
      "required": ["entrypoint"],
      "additionalProperties": false,
      "properties": {
        "entrypoint": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        }
      }
    }
  }
}
