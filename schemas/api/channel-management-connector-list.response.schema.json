        "limit": { "type": "integer", "minimum": 1 },
        "nextCursor": { "type": "string" },
        "order": { "const": "attention_disabled_ready_name_id" }
      }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "./channel-management-connector-resource.schema.json" }
    }
  }
