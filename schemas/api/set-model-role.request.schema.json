{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/api/set-model-role.request.schema.json",
  "title": "SetModelRoleRequest",
  "type": "object",
  "required": ["providerId"],
  "additionalProperties": false,
  "properties": {
    "providerId": {
      "type": "string",
      "minLength": 1,
      "description": "Provider serving this role. Unrouting is a DELETE, not an empty value."
    },
    "model": {
      "type": "string",
      "description": "Optional; empty uses the provider's default model."
    }
  }
}
