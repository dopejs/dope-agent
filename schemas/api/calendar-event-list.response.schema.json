{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/api/calendar-event-list.response.schema.json",
  "title": "CalendarEventListResponse",
  "type": "object",
  "required": ["account", "items", "operation"],
  "additionalProperties": false,
  "properties": {
    "tenantId": { "type": "string" },
    "account": { "$ref": "./calendar-account-resource.schema.json" },
    "items": {
      "type": "array",
      "items": { "$ref": "./calendar-event-resource.schema.json" }
    },
    "operation": { "$ref": "./calendar-operation-resource.schema.json" },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "./calendar-event-artifact.schema.json" }
    }
  }
}
