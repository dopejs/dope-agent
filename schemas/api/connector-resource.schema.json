{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/api/connector-resource.schema.json",
  "title": "ConnectorResource",
  "type": "object",
  "required": [
    "connectorId",
    "kind",
    "displayName",
    "status",
    "failureCount",
    "restartCount",
    "backoffSeconds",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "tenantId": { "type": "string" },
    "connectorId": { "type": "string" },
    "kind": { "type": "string" },
    "displayName": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["registered", "healthy", "degraded", "backing_off", "failed", "disabled"]
    },
    "disabledReason": { "type": "string" },
    "secretRefs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "secretSummary": {
      "type": "array",
      "items": { "$ref": "./tenant-secret-resource.schema.json#/$defs/redactedSecretSummary" }
    },
    "failureCount": { "type": "integer", "minimum": 0 },
    "restartCount": { "type": "integer", "minimum": 0 },
    "backoffSeconds": { "type": "integer", "minimum": 0 },
    "nextRestartAt": { "type": "string", "format": "date-time" },
    "lastRestartAt": { "type": "string", "format": "date-time" },
    "lastHeartbeatAt": { "type": "string", "format": "date-time" },
    "lastFailureReason": { "type": "string" },
    "capabilityProfile": { "$ref": "./connector-capability-profile.schema.json" },
    "diagnosticState": { "$ref": "./connector-diagnostic-state.schema.json" },
    "conformanceResult": { "$ref": "./connector-conformance-result.schema.json" },
    "accountBinding": { "$ref": "./connector-account-binding-summary.schema.json" },
    "slackSetup": { "$ref": "./slack-hosted-setup-resource.schema.json" },
    "slackRoutePolicy": { "$ref": "./slack-route-policy-resource.schema.json" },
    "slackSmokeEvidence": { "$ref": "./slack-smoke-evidence-resource.schema.json" },
    "matrixSetup": { "$ref": "./matrix-hosted-setup-resource.schema.json" },
    "matrixRoutePolicy": { "$ref": "./matrix-route-policy-resource.schema.json" },
    "matrixSmokeEvidence": { "$ref": "./matrix-smoke-evidence-resource.schema.json" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
