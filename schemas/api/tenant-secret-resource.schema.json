{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/api/tenant-secret-resource.schema.json",
  "title": "TenantSecretResource",
  "type": "object",
  "required": ["secretId", "tenantId", "secretRef", "status", "createdAt", "updatedAt"],
  "additionalProperties": false,
  "properties": {
    "secretId": { "type": "string" },
    "tenantId": { "type": "string" },
    "secretRef": { "type": "string" },
    "displayName": { "type": "string" },
    "status": { "type": "string", "enum": ["active", "disabled", "pending_remediation"] },
    "activeVersionId": { "type": "string" },
    "disabledReason": { "type": "string" },
    "remediationReason": { "type": "string" },
    "rotatedAt": { "type": "string", "format": "date-time" },
    "disabledAt": { "type": "string", "format": "date-time" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "document": { "type": "object", "additionalProperties": true },
    "secretRefs": {
      "type": "array",
      "items": { "$ref": "#/$defs/redactedSecretSummary" }
    }
  },
  "$defs": {
    "redactedSecretSummary": {
      "type": "object",
      "required": ["secretRef", "resolution", "redactionRule"],
      "additionalProperties": false,
      "properties": {
        "secretRef": { "type": "string" },
        "secretVersionId": { "type": "string" },
        "resolution": { "type": "string", "enum": ["resolved", "unavailable", "denied", "not_applicable"] },
        "status": { "type": "string", "enum": ["active", "disabled", "pending_remediation"] },
        "disabledReason": { "type": "string" },
        "redactionRule": { "type": "string" }
      }
    }
  }
}
