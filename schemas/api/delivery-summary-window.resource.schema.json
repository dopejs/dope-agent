{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/api/delivery-summary-window.resource.schema.json",
  "title": "DeliverySummaryWindowResource",
  "type": "object",
  "required": ["summaryWindowId", "environmentScope", "targetId", "preferenceId", "status", "windowStartedAt", "windowEndsAt", "resultCount", "createdAt", "updatedAt"],
  "additionalProperties": false,
  "properties": {
    "summaryWindowId": { "type": "string" },
    "environmentScope": { "type": "string", "enum": ["test", "prod"] },
    "targetId": { "type": "string" },
    "preferenceId": { "type": "string" },
    "status": { "type": "string", "enum": ["open", "ready", "dispatching", "delivered", "failed", "cancelled"] },
    "windowStartedAt": { "type": "string", "format": "date-time" },
    "windowEndsAt": { "type": "string", "format": "date-time" },
    "resultCount": { "type": "integer", "minimum": 0 },
    "emittedDeliveryId": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
