{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/api/billing-quota-dashboard.response.schema.json",
  "title": "BillingQuotaDashboardResponse",
  "type": "object",
  "required": ["plan", "sections", "generatedAt"],
  "additionalProperties": true,
  "properties": {
    "tenantId": { "type": "string" },
    "plan": {
      "type": "object",
      "required": ["planKey", "enforcementMode", "effectiveAt", "checkoutAvailable"],
      "additionalProperties": true,
      "properties": {
        "planKey": { "type": "string" },
        "enforcementMode": { "type": "string", "enum": ["enforced", "unlimited", "not_measurable"] },
        "status": { "type": "string" },
        "effectiveAt": { "type": "string", "format": "date-time" },
        "basePlanLabel": { "type": "string" },
        "checkoutAvailable": { "type": "boolean" }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sectionKey", "label", "items"],
        "additionalProperties": true,
        "properties": {
          "sectionKey": { "type": "string" },
          "label": { "type": "string" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/$defs/quotaStatusItem" }
          }
        }
      }
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "permission": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "allowed": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "quotaStatusItem": {
      "type": "object",
      "required": ["category", "unit", "status", "currentPeriod", "limit", "remainingAmount", "nearLimit", "typicalOperationAmount", "recoveryActions"],
      "additionalProperties": true,
      "properties": {
        "category": { "type": "string" },
        "unit": { "type": "string", "enum": ["count", "bytes", "attempts"] },
        "status": { "type": "string", "enum": ["available", "near_limit", "exhausted", "unlimited", "not_measurable", "restricted", "unavailable"] },
        "currentPeriod": { "$ref": "#/$defs/usagePeriod" },
        "previousPeriod": { "$ref": "#/$defs/usagePeriod" },
        "limit": { "type": "integer" },
        "remainingAmount": { "type": "integer" },
        "nearLimit": { "type": "boolean" },
        "nearLimitReason": { "type": "string", "enum": ["percent_threshold", "below_one_typical_operation"] },
        "typicalOperationAmount": { "type": "integer" },
        "baseLimit": { "type": "integer" },
        "effectiveLimit": { "type": "integer" },
        "recoveryActions": {
          "type": "array",
          "items": { "$ref": "#/$defs/recoveryAction" }
        },
        "override": {
          "type": "object",
          "additionalProperties": true
        },
        "restriction": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "usagePeriod": {
      "type": "object",
      "required": ["periodStart", "periodEnd", "periodAnchor", "consumedAmount", "reservedAmount", "adjustedAmount", "carryoverApplied", "remainingAmount"],
      "additionalProperties": true,
      "properties": {
        "periodStart": { "type": "string", "format": "date-time" },
        "periodEnd": { "type": "string", "format": "date-time" },
        "periodAnchor": { "type": "string" },
        "consumedAmount": { "type": "integer" },
        "reservedAmount": { "type": "integer" },
        "adjustedAmount": { "type": "integer" },
        "carryoverApplied": { "type": "integer" },
        "remainingAmount": { "type": "integer" },
        "overLimit": { "type": "boolean" }
      }
    },
    "recoveryAction": {
      "type": "string",
      "enum": ["wait", "reduce_scope", "request_override", "contact_support", "operator_resolution_required", "retry_later"]
    }
  }
}
