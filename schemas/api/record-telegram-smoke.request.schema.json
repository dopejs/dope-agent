{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/api/record-telegram-smoke.request.schema.json",
  "title": "RecordTelegramSmokeRequest",
  "type": "object",
  "required": ["connectorId", "status", "credentialMode"],
  "additionalProperties": false,
  "properties": {
    "connectorId": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["passed", "failed", "skipped"]
    },
    "credentialMode": {
      "type": "string",
      "enum": ["safe_live", "fake", "unavailable"]
    },
    "owner": { "type": "string" },
    "reason": { "type": "string" },
    "remainingRisk": { "type": "string" },
    "validatedAt": { "type": "string", "format": "date-time" },
    "safeEvidence": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
