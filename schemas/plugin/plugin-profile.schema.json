{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/plugin/plugin-profile.schema.json",
  "title": "PluginProfile",
  "description": "The per-data-dir plugin profile (<data_dir>/plugins.json). A missing file is the default profile: every builtin plugin enabled, no overrides.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "disabled": {
      "type": "array",
      "items": { "type": "string" }
    },
    "entries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "config": { "type": "object" }
        }
      }
    }
  }
}
