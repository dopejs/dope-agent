{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/events/tenant-access-denied.event.schema.json",
  "title": "TenantAccessDeniedEvent",
  "allOf": [{ "$ref": "./runtime-event.schema.json" }],
  "type": "object",
  "required": ["eventId", "sequence", "category", "name", "occurredAt", "resource", "scope", "payload"],
  "properties": {
    "category": { "const": "tenant" },
    "name": { "const": "tenant.access_denied" },
    "resource": {
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "tenant" },
        "id": { "type": "string" }
      }
    },
    "payload": {
      "type": "object",
      "required": ["principalId", "tokenId", "reasonCode"],
      "additionalProperties": false,
      "properties": {
        "principalId": { "type": "string" },
        "tokenId": { "type": "string" },
        "tenantId": { "type": "string" },
        "reasonCode": { "type": "string" }
      }
    }
  }
}
