{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/events/connector-reply-failed.event.schema.json",
  "title": "ConnectorReplyFailedEvent",
  "type": "object",
  "allOf": [
    {
      "$ref": "./runtime-event.schema.json"
    },
    {
      "properties": {
        "category": {
          "const": "connector"
        },
        "name": {
          "const": "connector.reply_failed"
        },
        "payload": {
          "type": "object",
          "required": [
            "messageId",
            "assistantExecutionOutcome"
          ],
          "oneOf": [
            { "required": ["discordDeliveryOutcome"] },
            { "required": ["connectorDeliveryOutcome"] }
          ],
          "additionalProperties": true,
          "properties": {
            "tenantId": { "type": "string" },
            "connectorId": { "type": "string" },
            "messageId": { "type": "string" },
            "replyMessageId": { "type": "string" },
            "assistantExecutionOutcome": {
              "type": "string",
              "enum": ["succeeded", "failed", "cancelled"]
            },
            "discordDeliveryOutcome": {
              "type": "string",
              "enum": ["sent", "edited", "failed", "degraded_to_final_only", "not_attempted"]
            },
            "connectorDeliveryOutcome": {
              "type": "string",
              "enum": ["sent", "edited", "failed", "degraded_to_final_only", "not_attempted"]
            },
            "connectorKind": { "type": "string" },
            "errorClass": { "type": "string" },
            "reasonCode": { "type": "string" },
            "redactionStatus": {
              "type": "string",
              "enum": ["redacted", "suppressed", "redaction_failed"]
            }
          }
        }
      }
    }
  ]
}
