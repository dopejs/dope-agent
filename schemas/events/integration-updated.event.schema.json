{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/events/integration-updated.event.schema.json",
  "title": "IntegrationUpdatedEvent",
  "allOf": [
    { "$ref": "./runtime-event.schema.json" },
    {
      "type": "object",
      "properties": {
        "category": { "const": "integration" },
        "name": { "const": "integration.updated" },
        "payload": {
          "type": "object",
          "required": ["integrationId", "domainKind", "displayName", "environmentScope", "readinessStatus", "canonicalDefault", "backendKind", "accountKey"],
          "additionalProperties": false,
          "properties": {
            "integrationId": { "type": "string" },
            "domainKind": { "type": "string" },
            "displayName": { "type": "string" },
            "environmentScope": { "type": "string" },
            "readinessStatus": {
              "type": "string",
              "enum": ["not_configured", "auth_pending", "healthy", "degraded", "unavailable"]
            },
            "canonicalDefault": { "type": "boolean" },
            "backendKind": {
              "type": "string",
              "enum": ["mcp", "managed_provider", "native", "fake_local"]
            },
            "accountKey": { "type": "string" }
          }
        }
      }
    }
  ]
}
