{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/events/reminder-delivery-linked.event.schema.json",
  "allOf": [
    { "$ref": "./runtime-event.schema.json" },
    {
      "type": "object",
      "properties": {
        "category": { "const": "reminder" },
        "name": { "const": "reminder.delivery_linked" },
        "resource": {
          "type": "object",
          "properties": {
            "kind": { "const": "reminder" }
          }
        },
        "payload": {
          "type": "object",
          "required": ["reminderId", "occurrenceId", "actionKind", "deliveryId"]
        }
      }
    }
  ]
}
