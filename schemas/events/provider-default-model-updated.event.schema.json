{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/events/provider-default-model-updated.event.schema.json",
  "allOf": [
    { "$ref": "./runtime-event.schema.json" },
    {
      "type": "object",
      "properties": {
        "category": { "const": "provider" },
        "name": { "const": "provider.default_model_updated" },
        "resource": {
          "type": "object",
          "required": ["kind", "id"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "provider" },
            "id": { "type": "string" }
          }
        },
        "payload": {
          "type": "object",
          "required": ["providerId", "defaultModel", "updatedAt"],
          "additionalProperties": false,
          "properties": {
            "providerId": { "type": "string" },
            "defaultModel": { "type": "string" },
            "updatedAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  ]
}
