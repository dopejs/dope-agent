{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/events/mcp-server-health-changed.event.schema.json",
  "title": "MCPServerHealthChangedEvent",
  "allOf": [
    { "$ref": "./runtime-event.schema.json" },
    {
      "type": "object",
      "properties": {
        "category": { "const": "mcp" },
        "name": { "const": "mcp.server_health_changed" },
        "resource": {
          "type": "object",
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "mcp_server" },
            "id": { "type": "string" }
          }
        },
        "payload": {
          "type": "object",
          "required": ["serverId", "status"],
          "additionalProperties": true,
          "properties": {
            "serverId": { "type": "string" },
            "status": { "type": "string" },
            "reason": { "type": "string" }
          }
        }
      }
    }
  ]
}
