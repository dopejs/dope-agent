{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/events/workflow-started.event.schema.json",
  "allOf": [
    { "$ref": "./runtime-event.schema.json" },
    {
      "type": "object",
      "properties": {
        "category": { "const": "workflow" },
        "name": { "const": "workflow.started" },
        "resource": {
          "type": "object",
          "properties": {
            "kind": { "const": "workflow" }
          }
        },
        "payload": {
          "type": "object",
          "required": ["workflowId", "runId", "status"]
        }
      }
    }
  ]
}
