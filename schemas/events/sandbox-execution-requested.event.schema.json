{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/events/sandbox-execution-requested.event.schema.json",
  "title": "SandboxExecutionRequestedEvent",
  "allOf": [
    { "$ref": "./runtime-event.schema.json" },
    {
      "type": "object",
      "required": ["payload"],
      "properties": {
        "category": { "const": "sandbox" },
        "name": { "const": "sandbox.execution_requested" },
        "resource": {
          "type": "object",
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "sandbox_execution" },
            "id": { "type": "string" }
          }
        },
        "payload": {
          "type": "object",
          "required": ["profileId", "backendKind", "command", "args", "cwd", "status"],
          "additionalProperties": true,
          "properties": {
            "profileId": { "type": "string" },
            "backendKind": { "type": "string" },
            "command": { "type": "string" },
            "args": { "type": "array", "items": { "type": "string" } },
            "cwd": { "type": "string" },
            "requestedBy": { "type": "string" },
            "resourceKind": { "type": "string" },
            "resourceId": { "type": "string" },
            "scope": { "type": "string" },
            "status": { "type": "string" },
            "managedProviderId": { "type": "string" },
            "managedProviderAction": { "type": "string" },
            "managedProviderOperationId": { "type": "string" },
            "sandboxProfileId": { "type": "string" },
            "sandboxDecision": { "type": "string" },
            "enforcementStrength": { "type": "string" },
            "failureClass": { "type": "string" },
            "sensitiveStateClasses": { "type": "string" }
          }
        }
      }
    }
  ]
}
