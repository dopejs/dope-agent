{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/events/tenant-token-issued.event.schema.json",
  "title": "TenantTokenIssuedEvent",
  "allOf": [{ "$ref": "./runtime-event.schema.json" }],
  "properties": {
    "category": { "const": "tenant" },
    "name": { "const": "tenant.token_issued" },
    "payload": { "$ref": "#/$defs/tokenPayload" }
  },
  "$defs": {
    "tokenPayload": {
      "type": "object",
      "required": ["principalId", "tokenId", "defaultTenantId"],
      "additionalProperties": false,
      "properties": {
        "principalId": { "type": "string" },
        "tokenId": { "type": "string" },
        "defaultTenantId": { "type": "string" },
        "allowedTenantIds": { "type": "array", "items": { "type": "string" } },
        "reasonCode": { "type": "string" }
      }
    }
  }
}
