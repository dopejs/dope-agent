{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/events/connector-delivery-separation-recorded.event.schema.json",
  "title": "ConnectorDeliverySeparationRecordedEvent",
  "type": "object",
  "allOf": [
    { "$ref": "./runtime-event.schema.json" },
    {
      "properties": {
        "category": { "const": "connector" },
        "name": { "const": "connector.delivery_separation_recorded" },
        "payload": {
          "type": "object",
          "required": [
            "tenantId",
            "connectorId",
            "transportKind",
            "separationStatus",
            "redactionStatus"
          ],
          "additionalProperties": true,
          "properties": {
            "tenantId": { "type": "string" },
            "connectorId": { "type": "string" },
            "foregroundReplyOutcomeId": { "type": "string" },
            "backgroundDeliveryId": { "type": "string" },
            "transportKind": { "type": "string" },
            "separationStatus": { "type": "string" },
            "redactionStatus": {
              "type": "string",
              "enum": ["redacted", "suppressed", "redaction_failed"]
            }
          }
        }
      }
    }
  ]
}
