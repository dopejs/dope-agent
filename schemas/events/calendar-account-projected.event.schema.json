{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/events/calendar-account-projected.event.schema.json",
  "title": "CalendarAccountProjectedEvent",
  "allOf": [
    { "$ref": "./runtime-event.schema.json" },
    {
      "type": "object",
      "properties": {
        "category": { "const": "calendar" },
        "name": { "const": "calendar.account_projected" },
        "payload": {
          "type": "object",
          "required": ["integrationId", "accountKey", "primaryCalendarRef", "primaryTimezone", "readinessStatus", "canonicalDefault"],
          "additionalProperties": false,
          "properties": {
            "integrationId": { "type": "string" },
            "accountKey": { "type": "string" },
            "primaryCalendarRef": { "type": "string" },
            "primaryTimezone": { "type": "string" },
            "readinessStatus": { "type": "string", "enum": ["not_configured", "auth_pending", "healthy", "degraded", "unavailable"] },
            "canonicalDefault": { "type": "boolean" }
          }
        }
      }
    }
  ]
}
