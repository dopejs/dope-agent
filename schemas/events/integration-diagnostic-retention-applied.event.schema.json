{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/events/integration-diagnostic-retention-applied.event.schema.json",
  "title": "IntegrationDiagnosticRetentionAppliedEvent",
  "allOf": [
    { "$ref": "./runtime-event.schema.json" },
    {
      "type": "object",
      "properties": {
        "category": { "const": "integration" },
        "name": { "const": "integration_diagnostic.retention_applied" },
        "payload": {
          "type": "object",
          "required": ["tenantId", "targetKind", "targetId", "retentionState", "effectiveExpiresAt"],
          "additionalProperties": false,
          "properties": {
            "tenantId": { "type": "string" },
            "targetKind": { "type": "string", "enum": ["diagnostic_run", "diagnostic_result", "smoke_report", "smoke_probe_outcome", "provider_classification"] },
            "targetId": { "type": "string" },
            "retentionState": { "type": "string", "enum": ["active", "expired", "purged", "extended"] },
            "effectiveExpiresAt": { "type": "string", "format": "date-time" },
            "policyRef": { "type": "string" }
          }
        }
      }
    }
  ]
}
