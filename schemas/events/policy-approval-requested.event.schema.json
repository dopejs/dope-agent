{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/events/policy-approval-requested.event.schema.json",
  "title": "PolicyApprovalRequestedEvent",
  "type": "object",
  "allOf": [
    { "$ref": "./runtime-event.schema.json" },
    {
      "type": "object",
      "properties": {
        "category": { "const": "policy" },
        "name": { "const": "policy.approval_requested" },
        "resource": {
          "type": "object",
          "required": ["kind", "id"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "approval" },
            "id": { "type": "string" }
          }
        },
        "payload": {
          "type": "object",
          "required": ["action", "resourceKind", "resourceId", "status"],
          "additionalProperties": false,
          "properties": {
            "action": { "type": "string" },
            "resourceKind": { "type": "string" },
            "resourceId": { "type": "string" },
            "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
            "reason": { "type": "string" },
            "requestedBy": { "type": "string" },
            "sandbox": { "$ref": "../api/sandbox-consumer-view.schema.json" }
          }
        }
      }
    }
  ]
}
