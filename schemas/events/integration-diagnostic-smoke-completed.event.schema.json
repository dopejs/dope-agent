{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/events/integration-diagnostic-smoke-completed.event.schema.json",
  "title": "IntegrationDiagnosticSmokeCompletedEvent",
  "allOf": [
    { "$ref": "./runtime-event.schema.json" },
    {
      "type": "object",
      "properties": {
        "category": { "const": "integration" },
        "name": { "const": "integration_diagnostic.smoke_completed" },
        "payload": {
          "type": "object",
          "required": ["tenantId", "smokeReportId", "status", "domainSummary"],
          "additionalProperties": false,
          "properties": {
            "tenantId": { "type": "string" },
            "smokeReportId": { "type": "string" },
            "status": { "type": "string", "enum": ["completed", "blocked", "failed", "published"] },
            "domainSummary": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "enum": ["passed", "failed", "blocked", "skipped", "limited", "unsupported"]
              }
            },
            "artifactRefs": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  ]
}
