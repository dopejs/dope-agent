{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/events/mcp-server-reconnect-completed.event.schema.json",
  "title": "MCPServerReconnectCompletedEvent",
  "allOf": [
    { "$ref": "./runtime-event.schema.json" },
    {
      "type": "object",
      "properties": {
        "category": { "const": "mcp" },
        "name": { "const": "mcp.server_reconnect_completed" },
        "resource": {
          "type": "object",
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "mcp_server" },
            "id": { "type": "string" }
          }
        },
        "payload": {
          "type": "object",
          "required": ["serverId", "transportKind", "attempt"],
          "additionalProperties": true,
          "properties": {
            "serverId": { "type": "string" },
            "transportKind": { "type": "string", "enum": ["websocket"] },
            "attempt": { "type": "integer", "minimum": 1 },
            "sessionId": { "type": "string" }
          }
        }
      }
    }
  ]
}
