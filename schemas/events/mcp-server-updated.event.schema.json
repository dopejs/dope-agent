{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/events/mcp-server-updated.event.schema.json",
  "title": "MCPServerUpdatedEvent",
  "allOf": [
    { "$ref": "./runtime-event.schema.json" },
    {
      "type": "object",
      "properties": {
        "category": { "const": "mcp" },
        "name": { "const": "mcp.server_updated" },
        "resource": {
          "type": "object",
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "mcp_server" },
            "id": { "type": "string" }
          }
        },
        "payload": {
          "type": "object",
          "required": ["serverId", "displayName", "enabled", "sandboxProfileId", "declarationId", "transportKind", "created"],
          "additionalProperties": true,
          "properties": {
            "serverId": { "type": "string" },
            "displayName": { "type": "string" },
            "enabled": { "type": "boolean" },
            "sandboxProfileId": { "type": "string" },
            "declarationId": { "type": "string" },
            "transportKind": { "type": "string" },
            "created": { "type": "boolean" }
          }
        }
      }
    }
  ]
}
