{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/events/connector-matrix-setup-validated.event.schema.json",
  "title": "ConnectorMatrixSetupValidatedEvent",
  "type": "object",
  "allOf": [
    { "$ref": "./runtime-event.schema.json" },
    {
      "properties": {
        "category": { "const": "connector" },
        "name": { "const": "connector.matrix_setup_validated" },
        "resource": {
          "type": "object",
          "required": ["kind", "id"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "matrix_hosted_setup" },
            "id": { "type": "string" }
          }
        },
        "payload": {
          "type": "object",
          "required": ["tenantId", "connectorId", "homeserverBindingId", "terminalState", "botCredentialState", "routePolicyState", "deliveryEligible", "reasonCode", "matrixCondition", "redactionStatus", "validatedAt"],
          "additionalProperties": true,
          "properties": {
            "tenantId": { "type": "string" },
            "connectorId": { "type": "string" },
            "homeserverBindingId": { "type": "string" },
            "terminalState": { "type": "string", "enum": ["ready", "degraded", "unavailable", "cancelled", "action-required"] },
            "botCredentialState": { "type": "string", "enum": ["not_started", "submitted", "valid", "invalid", "revoked", "permission_missing", "redaction_suppressed", "unknown"] },
            "routePolicyState": { "type": "string", "enum": ["none", "partial", "valid", "stale", "blocked"] },
            "deliveryEligible": { "type": "boolean" },
            "reasonCode": { "type": "string" },
            "matrixCondition": { "type": "string" },
            "redactionStatus": { "type": "string", "enum": ["redacted", "suppressed", "redaction_failed"] },
            "validatedAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  ]
}

