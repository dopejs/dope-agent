{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/events/audit-cross-tenant-access-denied.event.schema.json",
  "title": "AuditCrossTenantAccessDeniedEvent",
  "description": "Emitted when a request or store call is rejected because it would access or mutate a record owned by a different tenant. Distinct from R34's `tenant.access_denied` (which covers identity-boundary denials at tenant context resolution). Payload MUST NOT include the target tenant id, the target resource id, or any target row data.",
  "allOf": [{ "$ref": "./runtime-event.schema.json" }],
  "type": "object",
  "required": ["eventId", "sequence", "category", "name", "occurredAt", "resource", "scope", "payload"],
  "properties": {
    "category": { "const": "audit" },
    "name": { "const": "audit.cross_tenant_access_denied" },
    "resource": {
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "tenant" },
        "id": {
          "type": "string",
          "description": "The acting tenant id (the tenant context the caller resolved to). NOT the target tenant id.",
          "pattern": "^ten_[A-Za-z0-9]+$"
        }
      }
    },
    "payload": {
      "type": "object",
      "required": ["actingTenantId", "principalId", "surface", "resourceKind"],
      "additionalProperties": false,
      "properties": {
        "actingTenantId": {
          "type": "string",
          "description": "The tenant context resolved from the caller's session at the time of the denied access. Mirrors resource.id.",
          "pattern": "^ten_[A-Za-z0-9]+$"
        },
        "principalId": {
          "type": "string",
          "description": "The authenticated principal that made the request. Format follows daemon/internal/identity/manager.go: 'prn_<random>'.",
          "pattern": "^prn_[A-Za-z0-9]+$"
        },
        "surface": {
          "type": "string",
          "description": "Stable identifier of the surface that rejected the access. Format is '<surface_kind>:<route_or_helper>'. surface_kind is one of 'api', 'store', 'event'.",
          "minLength": 1,
          "examples": [
            "api:GET /v1/runs/{id}",
            "api:DELETE /v1/schedules/{id}",
            "store:ListSchedulesForTenant",
            "store:GetIntegrationForTenant",
            "event:SubscribeRunStream"
          ]
        },
        "resourceKind": {
          "type": "string",
          "description": "The kind of resource that the denied access targeted. MUST NOT include a resource id.",
          "examples": [
            "run", "step", "tool_call", "llm_dispatch", "checkpoint",
            "session", "approval", "decision",
            "schedule", "schedule_target", "schedule_dispatch_attempt",
            "workflow", "workflow_step", "workflow_dependency", "workflow_handoff",
            "integration",
            "delivery_target", "delivery_preference", "delivery_outcome", "delivery_attempt", "delivery_summary_window",
            "calendar_account", "calendar_operation", "calendar_artifact",
            "mail_account", "mail_operation", "mail_artifact",
            "reminder", "reminder_occurrence", "reminder_action",
            "computer_use_session", "computer_use_action", "computer_use_artifact",
            "evaluation_replay_candidate", "evaluation_replay_attempt", "evaluation_comparison", "evaluation_regression_fixture",
            "connector_message", "sandbox_execution", "consumer_policy_record",
            "provider_preference", "mcp_tool_exposure_rule", "secret_scope_binding",
            "event"
          ]
        }
      }
    }
  }
}
