{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/events/mcp-tool-exposure-updated.event.schema.json",
  "title": "MCPToolExposureUpdatedEvent",
  "allOf": [
    { "$ref": "./runtime-event.schema.json" },
    {
      "type": "object",
      "properties": {
        "category": { "const": "mcp" },
        "name": { "const": "mcp.tool_exposure_updated" },
        "resource": {
          "type": "object",
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "mcp_tool" },
            "id": { "type": "string" }
          }
        },
        "payload": {
          "type": "object",
          "required": ["serverId", "toolName", "runtimeSurface", "exposureMode", "active"],
          "additionalProperties": true,
          "properties": {
            "serverId": { "type": "string" },
            "toolName": { "type": "string" },
            "runtimeSurface": { "type": "string" },
            "exposureMode": { "type": "string" },
            "active": { "type": "boolean" },
            "reason": { "type": "string" }
          }
        }
      }
    }
  ]
}
