{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/events/mcp-catalog-install-completed.event.schema.json",
  "title": "MCPCatalogInstallCompletedEvent",
  "allOf": [
    { "$ref": "./runtime-event.schema.json" },
    {
      "type": "object",
      "properties": {
        "category": { "const": "mcp" },
        "name": { "const": "mcp.catalog_install_completed" },
        "payload": {
          "type": "object",
          "required": ["installId", "catalogEntryId", "serverId", "method", "status", "availabilityStatus"],
          "additionalProperties": false,
          "properties": {
            "installId": { "type": "string" },
            "catalogEntryId": { "type": "string" },
            "serverId": { "type": "string" },
            "method": { "type": "string", "enum": ["api", "script"] },
            "status": { "type": "string", "enum": ["installed"] },
            "availabilityStatus": { "type": "string", "enum": ["ready", "blocked", "unavailable", "unsupported"] },
            "availabilityReason": { "type": "string" }
          }
        }
      }
    }
  ]
}
