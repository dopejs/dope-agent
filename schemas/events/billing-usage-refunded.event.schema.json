{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/events/billing-usage-refunded.event.schema.json",
  "title": "BillingUsageRefundedEvent",
  "type": "object",
  "required": ["eventId", "sequence", "category", "name", "occurredAt", "scope", "resource", "payload"],
  "additionalProperties": true,
  "properties": {
    "eventId": { "type": "string" },
    "sequence": { "type": "integer" },
    "category": { "const": "billing" },
    "name": { "const": "billing.usage_refunded" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "scope": { "type": "object" },
    "resource": { "type": "object" },
    "payload": { "type": "object", "required": ["tenantId", "category", "operationKey", "amount"], "additionalProperties": true }
  }
}
