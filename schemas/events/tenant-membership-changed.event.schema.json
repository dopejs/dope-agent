{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/events/tenant-membership-changed.event.schema.json",
  "title": "TenantMembershipChangedEvent",
  "allOf": [{ "$ref": "./runtime-event.schema.json" }],
  "properties": {
    "category": { "const": "tenant" },
    "name": { "const": "tenant.membership_changed" },
    "payload": { "$ref": "#/$defs/payload" }
  },
  "$defs": {
    "payload": {
      "type": "object",
      "required": ["tenantId", "principalId", "membershipId", "reasonCode"],
      "additionalProperties": false,
      "properties": {
        "tenantId": { "type": "string" },
        "principalId": { "type": "string" },
        "membershipId": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" },
        "reasonCode": { "type": "string" }
      }
    }
  }
}
