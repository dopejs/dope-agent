{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/events/schedule-dispatch-recorded.event.schema.json",
  "allOf": [
    { "$ref": "./runtime-event.schema.json" },
    {
      "type": "object",
      "properties": {
        "category": { "const": "schedule" },
        "name": { "const": "schedule.dispatch_recorded" },
        "resource": {
          "type": "object",
          "properties": {
            "kind": { "const": "schedule" }
          }
        },
        "payload": {
          "type": "object",
          "required": ["scheduleId", "scheduleAttemptId", "dispatchStatus", "dueAt", "triggerSource"]
        }
      }
    }
  ]
}
