{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/events/live-validation-reconciliation-resolved.event.schema.json",
  "title": "LiveValidationReconciliationResolvedEvent",
  "allOf": [
    { "$ref": "./runtime-event.schema.json" },
    {
      "type": "object",
      "properties": {
        "category": { "const": "evaluation" },
        "name": { "const": "live_validation.reconciliation_resolved" },
        "payload": { "$ref": "#/$defs/payload" }
      }
    }
  ],
  "$defs": {
    "payload": {
      "type": "object",
      "required": ["validationId", "tenantId", "ambiguousCommitId", "reconciliationId", "resolution", "resolvedBy"],
      "properties": {
        "validationId": { "type": "string" },
        "tenantId": { "type": "string" },
        "ambiguousCommitId": { "type": "string" },
        "reconciliationId": { "type": "string" },
        "resolution": { "type": "string", "enum": ["confirmed_committed", "confirmed_not_committed", "compensated", "accepted_manual_state", "unsupported_unresolved"] },
        "resolvedBy": { "type": "string" }
      }
    }
  }
}
