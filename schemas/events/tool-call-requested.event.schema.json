{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/events/tool-call-requested.event.schema.json",
  "title": "ToolCallRequestedEvent",
  "allOf": [
    {
      "$ref": "./runtime-event.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "category": {
          "const": "tool_call"
        },
        "name": {
          "const": "tool_call.requested"
        },
        "payload": {
          "type": "object",
          "required": ["toolName", "status"],
          "additionalProperties": false,
          "anyOf": [
            { "required": ["capabilityId"] },
            { "required": ["skillId"] }
          ],
          "properties": {
            "invocationKind": {
              "type": "string",
              "enum": ["local_tool", "skill"]
            },
            "capabilityId": {
              "type": "string"
            },
            "skillId": {
              "type": "string"
            },
            "toolName": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": ["requested"]
            },
            "sandboxExecutionId": {
              "type": "string"
            },
            "failureClass": {
              "type": "string"
            }
          }
        }
      }
    }
  ]
}
