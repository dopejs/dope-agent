{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/events/tool-call-requested.event.schema.json",
  "title": "ToolCallRequestedEvent",
  "allOf": [
    {
      "$ref": "./runtime-event.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "category": {
          "const": "tool_call"
        },
        "name": {
          "const": "tool_call.requested"
        },
        "payload": {
          "type": "object",
          "required": ["toolName", "status"],
          "additionalProperties": false,
          "anyOf": [
            { "required": ["capabilityId"] },
            { "required": ["skillId"] },
            { "required": ["mcpServerId"] },
            { "required": ["domainKind"] }
          ],
          "properties": {
            "invocationKind": {
              "type": "string",
              "enum": ["local_tool", "skill", "mcp_tool", "domain_tool"]
            },
            "domainKind": {
              "type": "string"
            },
            "capabilityId": {
              "type": "string"
            },
            "skillId": {
              "type": "string"
            },
            "mcpServerId": {
              "type": "string"
            },
            "mcpServerName": {
              "type": "string"
            },
            "mcpToolName": {
              "type": "string"
            },
            "mcpTransportKind": {
              "type": "string",
              "enum": ["stdio", "streamable-http", "websocket"]
            },
            "mcpSessionId": {
              "type": "string"
            },
            "authorizationResult": {
              "type": "string",
              "enum": ["allowed", "pending", "rejected", "blocked"]
            },
            "toolName": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": ["requested"]
            },
            "sandboxExecutionId": {
              "type": "string"
            },
            "integrationBindings": {
              "type": "array",
              "items": { "$ref": "../api/integration-binding-summary.schema.json" }
            },
            "failureClass": {
              "type": "string"
            },
            "output": {
              "type": ["object", "array", "string", "number", "boolean", "null"]
            }
          }
        }
      }
    }
  ]
}
