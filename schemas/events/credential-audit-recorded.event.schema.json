{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/events/credential-audit-recorded.event.schema.json",
  "title": "CredentialAuditRecordedEvent",
  "allOf": [{ "$ref": "./runtime-event.schema.json" }],
  "type": "object",
  "required": ["eventId", "sequence", "category", "name", "occurredAt", "resource", "scope", "payload"],
  "properties": {
    "category": { "const": "tenant" },
    "name": { "const": "credential.audit_recorded" },
    "resource": {
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string" },
        "id": { "type": "string" }
      }
    },
    "payload": {
      "type": "object",
      "required": ["tenantId", "action", "outcome", "resourceKind"],
      "additionalProperties": false,
      "properties": {
        "tenantId": { "type": "string" },
        "principalId": { "type": "string" },
        "resourceKind": { "type": "string" },
        "resourceId": { "type": "string" },
        "action": { "type": "string" },
        "outcome": { "type": "string", "enum": ["succeeded", "denied", "failed_closed"] },
        "reasonCode": { "type": "string" },
        "secretRef": { "type": "string" },
        "secretVersionId": { "type": "string" },
        "secretRefCount": { "type": "integer", "minimum": 0 },
        "secretRefs": {
          "type": "array",
          "items": { "$ref": "../api/tenant-secret-resource.schema.json#/$defs/redactedSecretSummary" }
        }
      }
    }
  }
}
