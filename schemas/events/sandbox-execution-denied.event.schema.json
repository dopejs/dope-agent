{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/events/sandbox-execution-denied.event.schema.json",
  "title": "SandboxExecutionDeniedEvent",
  "allOf": [
    { "$ref": "./runtime-event.schema.json" },
    {
      "type": "object",
      "properties": {
        "category": { "const": "sandbox" },
        "name": { "const": "sandbox.execution_denied" },
        "resource": {
          "type": "object",
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "sandbox_execution" },
            "id": { "type": "string" }
          }
        },
        "payload": {
          "type": "object",
          "required": ["profileId", "backendKind", "status", "outputTruncated", "partial", "errorClass", "errorCode", "error"],
          "additionalProperties": true,
          "properties": {
            "profileId": { "type": "string" },
            "backendKind": { "type": "string" },
            "status": { "type": "string" },
            "completedAt": { "type": "string", "format": "date-time" },
            "outputTruncated": { "type": "boolean" },
            "partial": { "type": "boolean" },
            "errorClass": { "type": "string" },
            "errorCode": { "type": "string" },
            "error": { "type": "string" },
            "managedProviderId": { "type": "string" },
            "managedProviderAction": { "type": "string" },
            "managedProviderOperationId": { "type": "string" },
            "sandboxProfileId": { "type": "string" },
            "sandboxDecision": { "type": "string" },
            "enforcementStrength": { "type": "string" },
            "failureClass": { "type": "string" },
            "sensitiveStateClasses": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  ]
}
