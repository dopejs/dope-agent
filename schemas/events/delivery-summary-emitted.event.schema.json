{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/events/delivery-summary-emitted.event.schema.json",
  "allOf": [
    { "$ref": "./runtime-event.schema.json" },
    {
      "type": "object",
      "properties": {
        "category": { "const": "delivery" },
        "name": { "const": "delivery.summary_emitted" },
        "resource": { "type": "object", "properties": { "kind": { "const": "delivery_summary_window" } } },
        "payload": { "type": "object", "required": ["summaryWindowId", "resultCount", "emittedDeliveryId"] }
      }
    }
  ]
}
