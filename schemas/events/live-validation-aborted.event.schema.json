{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/events/live-validation-aborted.event.schema.json",
  "title": "LiveValidationAbortedEvent",
  "type": "object",
  "required": ["eventId", "sequence", "category", "name", "occurredAt", "resource", "payload"],
  "additionalProperties": true,
  "properties": {
    "name": { "const": "live_validation.aborted" },
    "payload": {
      "type": "object",
      "required": ["validationId", "tenantId", "status"],
      "additionalProperties": true,
      "properties": {
        "validationId": { "type": "string" },
        "tenantId": { "type": "string" },
        "status": { "const": "aborted" },
        "reasonCode": { "type": "string" }
      }
    }
  }
}
