{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/events/mcp-catalog-lifecycle-completed.event.schema.json",
  "title": "MCPCatalogLifecycleCompletedEvent",
  "allOf": [
    { "$ref": "./runtime-event.schema.json" },
    {
      "type": "object",
      "properties": {
        "category": { "const": "mcp" },
        "name": { "const": "mcp.catalog_lifecycle_completed" },
        "resource": {
          "type": "object",
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "mcp_server" },
            "id": { "type": "string" }
          }
        },
        "payload": {
          "type": "object",
          "required": ["actionId", "action", "serverId", "catalogEntryId", "status", "environment"],
          "additionalProperties": false,
          "properties": {
            "actionId": { "type": "string" },
            "action": { "type": "string", "enum": ["refresh", "reinstall", "uninstall"] },
            "serverId": { "type": "string" },
            "catalogEntryId": { "type": "string" },
            "status": { "const": "completed" },
            "removed": { "type": "boolean" },
            "environment": { "type": "string", "enum": ["test", "prod"] }
          }
        }
      }
    }
  ]
}
