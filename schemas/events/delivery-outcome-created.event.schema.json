{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kura.local/schemas/events/delivery-outcome-created.event.schema.json",
  "allOf": [
    { "$ref": "./runtime-event.schema.json" },
    {
      "type": "object",
      "properties": {
        "category": { "const": "delivery" },
        "name": { "const": "delivery.outcome_created" },
        "resource": { "type": "object", "properties": { "kind": { "const": "delivery" } } },
        "payload": { "type": "object", "required": ["deliveryId", "sourceKind", "sourceId", "resultClass", "mode", "status"] }
      }
    }
  ]
}
