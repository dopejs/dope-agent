{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/events/integration-diagnostic-state-changed.event.schema.json",
  "title": "IntegrationDiagnosticStateChangedEvent",
  "allOf": [
    { "$ref": "./runtime-event.schema.json" },
    {
      "type": "object",
      "properties": {
        "category": { "const": "integration" },
        "name": { "const": "integration_diagnostic.state_changed" },
        "payload": {
          "type": "object",
          "required": ["tenantId", "diagnosticResultId", "integrationId", "previousStatus", "status", "reasonCode"],
          "additionalProperties": false,
          "properties": {
            "tenantId": { "type": "string" },
            "diagnosticResultId": { "type": "string" },
            "integrationId": { "type": "string" },
            "previousStatus": { "type": "string", "enum": ["unknown", "healthy", "degraded", "blocked", "unsupported"] },
            "status": { "type": "string", "enum": ["unknown", "healthy", "degraded", "blocked", "unsupported"] },
            "reasonCode": { "$ref": "../api/integration-diagnostic-reason-code.schema.json#/$defs/reasonCodeValue" },
            "remediationOwner": { "$ref": "../api/integration-diagnostic-reason-code.schema.json#/$defs/remediationOwner" }
          }
        }
      }
    }
  ]
}
