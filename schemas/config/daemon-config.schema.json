{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/config/daemon-config.schema.json",
  "title": "DaemonConfig",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "environment": {
      "type": "string",
      "enum": ["prod", "test"],
      "default": "test"
    },
    "bindAddr": {
      "type": "string",
      "default": "127.0.0.1:19192"
    },
    "dataDir": {
      "type": "string",
      "default": "~/.dope-test"
    },
    "logLevel": {
      "type": "string",
      "enum": ["debug", "info", "warn", "error"],
      "default": "info"
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultProvider": {
          "type": "string",
          "default": ""
        },
        "defaultModel": {
          "type": "string",
          "default": ""
        },
        "defaultTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "default": 30000
        },
        "defaultMaxRetries": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "openaiCompatible": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baseURL": {
              "type": "string"
            },
            "apiKey": {
              "type": "string"
            },
            "apiKeyEnv": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1,
              "default": 30000
            },
            "streamFirstChunkTimeoutMs": {
              "type": "integer",
              "minimum": 1,
              "default": 30000
            },
            "streamIdleTimeoutMs": {
              "type": "integer",
              "minimum": 1,
              "default": 30000
            },
            "streamMaxDurationMs": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        },
        "claude": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cliPath": {
              "type": "string"
            },
            "defaultModel": {
              "type": "string"
            },
            "workDir": {
              "type": "string"
            }
          }
        },
        "codex": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cliPath": {
              "type": "string"
            },
            "defaultModel": {
              "type": "string"
            },
            "workDir": {
              "type": "string"
            }
          }
        }
      }
    },
    "connectors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "discord": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "connectorId": {
              "type": "string",
              "default": "discord-main"
            },
            "displayName": {
              "type": "string",
              "default": "Discord Main"
            },
            "deliveryMode": {
              "type": "string",
              "enum": ["gateway"],
              "default": "gateway"
            },
            "botToken": {
              "type": "string"
            },
            "botTokenEnv": {
              "type": "string"
            },
            "requireMention": {
              "type": "boolean",
              "default": true
            },
            "respondInDM": {
              "type": "boolean",
              "default": true
            },
            "allowedGuildIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allowedChannelIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
