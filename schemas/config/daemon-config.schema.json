{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dope.local/schemas/config/daemon-config.schema.json",
  "title": "DaemonConfig",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "bindAddr": {
      "type": "string",
      "default": "127.0.0.1:18789"
    },
    "dataDir": {
      "type": "string",
      "default": "~/.dope"
    },
    "logLevel": {
      "type": "string",
      "enum": ["debug", "info", "warn", "error"],
      "default": "info"
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultProvider": {
          "type": "string",
          "default": ""
        },
        "defaultModel": {
          "type": "string",
          "default": ""
        },
        "defaultTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "default": 30000
        },
        "defaultMaxRetries": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "openaiCompatible": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baseURL": {
              "type": "string"
            },
            "apiKey": {
              "type": "string"
            },
            "apiKeyEnv": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1,
              "default": 30000
            }
          }
        },
        "claude": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cliPath": {
              "type": "string"
            },
            "defaultModel": {
              "type": "string"
            },
            "workDir": {
              "type": "string"
            }
          }
        },
        "codex": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cliPath": {
              "type": "string"
            },
            "defaultModel": {
              "type": "string"
            },
            "workDir": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
